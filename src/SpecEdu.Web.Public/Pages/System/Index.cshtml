@page
@model SpecEdu.Web.Public.Pages.System.IndexModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["SystemPage.Title"];
    ViewData["Description"] = "SpecEdu – moderní systém pro správu dokumentace žáků se speciálními vzdělávacími potřebami. Pro školy, učitele, rodiče i poradenská zařízení.";
}

<!-- Hero Section -->
<section class="bg-spec-primary-light py-5 fade-up">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold mb-3">@L["SystemPage.Title"]</h1>
                <p class="lead text-muted mb-4">@L["SystemPage.Subtitle"]</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-page="/Account/Register" class="btn btn-spec-primary btn-lg">@L["SystemPage.TryFree"]</a>
                    <a asp-page="/HowItWorks" class="btn btn-spec-outline btn-lg">@L["SystemPage.LearnMore"]</a>
                </div>
            </div>
            <div class="col-lg-6 mt-4 mt-lg-0">
                <img src="~/img/system-hero.jpg"
                     alt="@L["SystemPage.Title"]" class="img-fluid rounded shadow-lg" width="600" height="400">
            </div>
        </div>
    </div>
</section>

<!-- Features Overview -->
<section class="py-5 fade-up">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">@L["SystemPage.WhySpecEdu"]</h2>
            <p class="text-muted">@L["SystemPage.WhySpecEduDesc"]</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="spec-card h-100 p-4 text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <spec-icon name="info-circle-fill" size="32" class="text-spec-primary"></spec-icon>
                    </div>
                    <h5 class="fw-bold">@L["SystemPage.Feature1Title"]</h5>
                    <p class="text-muted mb-0">@L["SystemPage.Feature1Desc"]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="spec-card h-100 p-4 text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <spec-icon name="geo-alt-fill" size="32" class="text-spec-primary"></spec-icon>
                    </div>
                    <h5 class="fw-bold">@L["SystemPage.Feature2Title"]</h5>
                    <p class="text-muted mb-0">@L["SystemPage.Feature2Desc"]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="spec-card h-100 p-4 text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <spec-icon name="headset" size="32" class="text-spec-primary"></spec-icon>
                    </div>
                    <h5 class="fw-bold">@L["SystemPage.Feature3Title"]</h5>
                    <p class="text-muted mb-0">@L["SystemPage.Feature3Desc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Pilot program callout -->
<section class="bg-spec-primary text-white py-5 fade-up">
    <div class="container text-center">
        <span class="badge bg-light text-spec-primary mb-3">Pilotní program</span>
        <h2 class="fw-bold mb-3">Buďte mezi prvními, kdo SpecEdu vyzkouší</h2>
        <p class="mb-4 opacity-75">
            SpecEdu se aktuálně připravuje na ostrý provoz. Hledáme školy a poradenská zařízení, která systém otestují jako první.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a asp-page="/Account/Register" class="btn btn-light btn-lg">Požádat o pilot</a>
            <a asp-page="/Contact" class="btn btn-outline-light btn-lg">Kontaktovat nás</a>
        </div>
    </div>
</section>
