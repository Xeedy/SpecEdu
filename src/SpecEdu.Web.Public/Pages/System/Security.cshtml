@page
@model SpecEdu.Web.Public.Pages.System.SecurityModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["SecurityPage.Title"];
}

<!-- Hero -->
<section class="bg-spec-primary-light py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 mx-auto text-center">
                <div class="bg-spec-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="white" viewBox="0 0 16 16">
                        <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
                        <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                    </svg>
                </div>
                <h1 class="display-5 fw-bold mb-3">@L["SecurityPage.Title"]</h1>
                <p class="lead text-muted">@L["SecurityPage.Subtitle"]</p>
            </div>
        </div>
    </div>
</section>

<!-- Security Features -->
<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">@L["SecurityPage.EncryptionTitle"]</h5>
                    <p class="text-muted mb-0">@L["SecurityPage.EncryptionDesc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">@L["SecurityPage.AccessControlTitle"]</h5>
                    <p class="text-muted mb-0">@L["SecurityPage.AccessControlDesc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">@L["SecurityPage.AuditTitle"]</h5>
                    <p class="text-muted mb-0">@L["SecurityPage.AuditDesc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4 .5a.5.5 0 0 0-1 0V1H2a2 2 0 0 0-2 2v1h16V3a2 2 0 0 0-2-2h-1V.5a.5.5 0 0 0-1 0V1H4V.5zM16 14V5H0v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2zM9.5 7h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">@L["SecurityPage.BackupTitle"]</h5>
                    <p class="text-muted mb-0">@L["SecurityPage.BackupDesc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm7.5-6.923c-.67.204-1.335.82-1.887 1.855A7.97 7.97 0 0 0 5.145 4H7.5V1.077zM4.09 4a9.267 9.267 0 0 1 .64-1.539 6.7 6.7 0 0 1 .597-.933A7.025 7.025 0 0 0 2.255 4H4.09zm-.582 3.5c.03-.877.138-1.718.312-2.5H1.674a6.958 6.958 0 0 0-.656 2.5h2.49zM4.847 5a12.5 12.5 0 0 0-.338 2.5H7.5V5H4.847zM8.5 5v2.5h2.99a12.495 12.495 0 0 0-.337-2.5H8.5z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">@L["SecurityPage.GdprTitle"]</h5>
                    <p class="text-muted mb-0">@L["SecurityPage.GdprDesc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">@L["SecurityPage.CertTitle"]</h5>
                    <p class="text-muted mb-0">@L["SecurityPage.CertDesc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- GDPR Section -->
<section class="bg-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="fw-bold mb-4">@L["SecurityPage.GdprSectionTitle"]</h2>
                <p class="text-muted mb-4">@L["SecurityPage.GdprSectionDesc"]</p>
                <ul class="list-unstyled">
                    <li class="mb-3 d-flex">
                        <span class="text-spec-primary me-3">&#10003;</span>
                        <span>@L["SecurityPage.GdprPoint1"]</span>
                    </li>
                    <li class="mb-3 d-flex">
                        <span class="text-spec-primary me-3">&#10003;</span>
                        <span>@L["SecurityPage.GdprPoint2"]</span>
                    </li>
                    <li class="mb-3 d-flex">
                        <span class="text-spec-primary me-3">&#10003;</span>
                        <span>@L["SecurityPage.GdprPoint3"]</span>
                    </li>
                    <li class="mb-3 d-flex">
                        <span class="text-spec-primary me-3">&#10003;</span>
                        <span>@L["SecurityPage.GdprPoint4"]</span>
                    </li>
                </ul>
                <a asp-page="/Legal/Privacy" class="btn btn-spec-outline">@L["SecurityPage.ReadPrivacyPolicy"]</a>
            </div>
            <div class="col-lg-6 mt-4 mt-lg-0 text-center">
                <img src="https://images.unsplash.com/photo-1563013544-824ae1b704d3?w=500&h=400&fit=crop"
                     alt="GDPR" class="img-fluid rounded shadow">
            </div>
        </div>
    </div>
</section>
