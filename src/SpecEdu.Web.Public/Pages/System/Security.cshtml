@page
@model SpecEdu.Web.Public.Pages.System.SecurityModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Description"] = "Bezpečnost a soulad s GDPR ve SpecEdu – role, oprávnění, šifrování dat a auditní stopa pro citlivá data o žácích.";
}
@{
    ViewData["Title"] = L["SecurityPage.Title"];
}

<!-- Hero -->
<section class="bg-spec-primary-light py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 mx-auto text-center">
                <div class="bg-spec-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                    <spec-icon name="shield-check" size="40" class="text-white"></spec-icon>
                </div>
                <h1 class="display-5 fw-bold mb-3">@L["SecurityPage.Title"]</h1>
                <p class="lead text-muted">@L["SecurityPage.Subtitle"]</p>
            </div>
        </div>
    </div>
</section>

<!-- Security Features -->
<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <spec-icon name="lock-fill" size="32"></spec-icon>
                    </div>
                    <h5 class="fw-bold">@L["SecurityPage.EncryptionTitle"]</h5>
                    <p class="text-muted mb-0">@L["SecurityPage.EncryptionDesc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <spec-icon name="person-fill" size="32"></spec-icon>
                    </div>
                    <h5 class="fw-bold">@L["SecurityPage.AccessControlTitle"]</h5>
                    <p class="text-muted mb-0">@L["SecurityPage.AccessControlDesc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <spec-icon name="info-circle-fill" size="32"></spec-icon>
                    </div>
                    <h5 class="fw-bold">@L["SecurityPage.AuditTitle"]</h5>
                    <p class="text-muted mb-0">@L["SecurityPage.AuditDesc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <spec-icon name="calendar-event" size="32"></spec-icon>
                    </div>
                    <h5 class="fw-bold">@L["SecurityPage.BackupTitle"]</h5>
                    <p class="text-muted mb-0">@L["SecurityPage.BackupDesc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <spec-icon name="globe" size="32"></spec-icon>
                    </div>
                    <h5 class="fw-bold">@L["SecurityPage.GdprTitle"]</h5>
                    <p class="text-muted mb-0">@L["SecurityPage.GdprDesc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <spec-icon name="check-circle" size="32"></spec-icon>
                    </div>
                    <h5 class="fw-bold">@L["SecurityPage.CertTitle"]</h5>
                    <p class="text-muted mb-0">@L["SecurityPage.CertDesc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- GDPR Section -->
<section class="bg-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="fw-bold mb-4">@L["SecurityPage.GdprSectionTitle"]</h2>
                <p class="text-muted mb-4">@L["SecurityPage.GdprSectionDesc"]</p>
                <ul class="list-unstyled">
                    <li class="mb-3 d-flex">
                        <span class="text-spec-primary me-3">&#10003;</span>
                        <span>@L["SecurityPage.GdprPoint1"]</span>
                    </li>
                    <li class="mb-3 d-flex">
                        <span class="text-spec-primary me-3">&#10003;</span>
                        <span>@L["SecurityPage.GdprPoint2"]</span>
                    </li>
                    <li class="mb-3 d-flex">
                        <span class="text-spec-primary me-3">&#10003;</span>
                        <span>@L["SecurityPage.GdprPoint3"]</span>
                    </li>
                    <li class="mb-3 d-flex">
                        <span class="text-spec-primary me-3">&#10003;</span>
                        <span>@L["SecurityPage.GdprPoint4"]</span>
                    </li>
                </ul>
                <a asp-page="/Legal/Privacy" class="btn btn-spec-outline">@L["SecurityPage.ReadPrivacyPolicy"]</a>
            </div>
            <div class="col-lg-6 mt-4 mt-lg-0 text-center">
                <img src="~/img/security-gdpr.jpg"
                     alt="@L["SecurityPage.GdprTitle"]" class="img-fluid rounded shadow" loading="lazy" width="500" height="400">
            </div>
        </div>
    </div>
</section>
