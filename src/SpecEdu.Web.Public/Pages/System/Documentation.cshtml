@page
@model SpecEdu.Web.Public.Pages.System.DocumentationModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["DocumentationPage.Title"];
    ViewData["Description"] = "Dokumentace a nápověda k systému SpecEdu – průvodce pro administrátory, učitele i pracovníky poradenských zařízení.";
}

<!-- Hero -->
<section class="bg-spec-primary-light py-5">
    <div class="container">
        <h1 class="display-5 fw-bold text-center mb-3">@L["DocumentationPage.Title"]</h1>
        <p class="lead text-center text-muted mb-0">@L["DocumentationPage.Subtitle"]</p>
    </div>
</section>

<!-- Search -->
<section class="py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="input-group input-group-lg">
                    <input type="text" class="form-control" placeholder="@L["DocumentationPage.SearchPlaceholder"]">
                    <button class="btn btn-spec-primary" type="button">
                        <spec-icon name="search" size="20"></spec-icon>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Glossary -->
<section class="py-5">
    <div class="container">
        <h2 class="fw-bold mb-4">@L["DocumentationPage.GlossaryTitle"]</h2>
        <div class="accordion" id="glossaryAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#spp">
                        <strong>SPP</strong>&nbsp;- @L["DocumentationPage.SppShort"]
                    </button>
                </h2>
                <div id="spp" class="accordion-collapse collapse show" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.SppDesc"]</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ppp">
                        <strong>PPP</strong>&nbsp;- @L["DocumentationPage.PppShort"]
                    </button>
                </h2>
                <div id="ppp" class="accordion-collapse collapse" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.PppDesc"]</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#spc">
                        <strong>SPC</strong>&nbsp;- @L["DocumentationPage.SpcShort"]
                    </button>
                </h2>
                <div id="spc" class="accordion-collapse collapse" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.SpcDesc"]</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#svp">
                        <strong>SVP</strong>&nbsp;- @L["DocumentationPage.SvpShort"]
                    </button>
                </h2>
                <div id="svp" class="accordion-collapse collapse" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.SvpDesc"]</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#plpp">
                        <strong>PLPP</strong>&nbsp;- @L["DocumentationPage.PlppShort"]
                    </button>
                </h2>
                <div id="plpp" class="accordion-collapse collapse" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.PlppDesc"]</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ivp">
                        <strong>IVP</strong>&nbsp;- @L["DocumentationPage.IvpShort"]
                    </button>
                </h2>
                <div id="ivp" class="accordion-collapse collapse" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.IvpDesc"]</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#po">
                        <strong>PO</strong>&nbsp;- @L["DocumentationPage.PoShort"]
                    </button>
                </h2>
                <div id="po" class="accordion-collapse collapse" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.PoDesc"]</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Quick Links -->
<section class="bg-white py-5">
    <div class="container">
        <h2 class="fw-bold mb-4">@L["DocumentationPage.QuickLinksTitle"]</h2>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <a href="#" class="spec-card p-4 d-block text-decoration-none h-100">
                    <div class="text-spec-primary mb-3">
                        <spec-icon name="book" size="32"></spec-icon>
                    </div>
                    <h5 class="fw-bold text-dark">@L["DocumentationPage.GettingStarted"]</h5>
                    <p class="text-muted mb-0 small">@L["DocumentationPage.GettingStartedDesc"]</p>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a href="#" class="spec-card p-4 d-block text-decoration-none h-100">
                    <div class="text-spec-primary mb-3">
                        <spec-icon name="gear-fill" size="32"></spec-icon>
                    </div>
                    <h5 class="fw-bold text-dark">@L["DocumentationPage.UserGuide"]</h5>
                    <p class="text-muted mb-0 small">@L["DocumentationPage.UserGuideDesc"]</p>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a href="#" class="spec-card p-4 d-block text-decoration-none h-100">
                    <div class="text-spec-primary mb-3">
                        <spec-icon name="question-circle" size="32"></spec-icon>
                    </div>
                    <h5 class="fw-bold text-dark">@L["DocumentationPage.FAQ"]</h5>
                    <p class="text-muted mb-0 small">@L["DocumentationPage.FAQDesc"]</p>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a href="#" class="spec-card p-4 d-block text-decoration-none h-100">
                    <div class="text-spec-primary mb-3">
                        <spec-icon name="info-square" size="32"></spec-icon>
                    </div>
                    <h5 class="fw-bold text-dark">@L["DocumentationPage.VideoTutorials"]</h5>
                    <p class="text-muted mb-0 small">@L["DocumentationPage.VideoTutorialsDesc"]</p>
                </a>
            </div>
        </div>
    </div>
</section>
