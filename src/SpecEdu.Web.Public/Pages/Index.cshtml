                    </ul>
                    <a asp-page="/Contact" class="btn btn-spec-primary w-100">Mám zájem o pilot</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Bezpečnost a GDPR -->
<section class="bg-white py-5 fade-up">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6 order-lg-2">
                <span class="badge bg-spec-primary mb-3">GDPR</span>
                <h2 class="fw-bold mb-3">Bezpečnost dat dětí na prvním místě</h2>
                <p class="text-muted mb-3">
                    Pracujeme s nejcitlivějšími daty – psychologickými zprávami, lékařskými doporučeními, údaji o speciálních potřebách dětí.
                    SpecEdu je proto navržen tak, aby tato data zůstala přístupná jen těm, kdo na ně mají právo.
                </p>
                <ul class="list-unstyled mb-4">
                    <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> Šifrování dat při přenosu i v úložišti</li>
                    <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> Role-based přístup s logováním všech operací</li>
                    <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> Pravidelné zálohování a možnost obnovy dat</li>
                    <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> Hosting v EU, plně v souladu s nařízením GDPR</li>
                </ul>
                <a asp-page="/System/Security" class="btn btn-spec-primary">Více o bezpečnosti</a>
            </div>
            <div class="col-lg-6 order-lg-1 text-center">
                <img src="~/img/security-gdpr.png" alt="Bezpečnost a GDPR" class="img-fluid rounded shadow" loading="lazy" width="500" height="400" />
            </div>
        </div>
