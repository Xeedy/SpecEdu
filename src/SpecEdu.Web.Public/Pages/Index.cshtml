<!-- Jak SpecEdu funguje -->
<section class="bg-spec-primary-light py-5 fade-up">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Jak SpecEdu funguje</h2>
            <p class="text-muted">Od založení účtu k plně digitalizované agendě – ve čtyřech jednoduchých krocích.</p>
        </div>
        <div class="row g-4 fade-up-stagger">
            <div class="col-md-6 col-lg-3">
                <div class="text-center">
                    <div class="bg-spec-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <span class="h4 mb-0 fw-bold">1</span>
                    </div>
                    <h6 class="fw-bold">Registrace školy</h6>
                    <p class="text-muted small mb-0">Vedení školy si zřídí účet a pozve své učitele i poradenská zařízení.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="text-center">
                    <div class="bg-spec-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <span class="h4 mb-0 fw-bold">2</span>
                    </div>
                    <h6 class="fw-bold">Založení složek žáků</h6>
                    <p class="text-muted small mb-0">Učitelé vytvoří karty dětí a propojí je s rodiči a relevantním poradenským zařízením.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="text-center">
                    <div class="bg-spec-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <span class="h4 mb-0 fw-bold">3</span>
                    </div>
                    <h6 class="fw-bold">Sdílení dokumentů</h6>
                    <p class="text-muted small mb-0">Poradny nahrají doporučení, učitelé doplňují zápisy, rodič dostane přístup ke svému dítěti.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="text-center">
                    <div class="bg-spec-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <span class="h4 mb-0 fw-bold">4</span>
                    </div>
                    <h6 class="fw-bold">Bez chaosu, vždy aktuální</h6>
                    <p class="text-muted small mb-0">Notifikace upozorní na termíny, historie zůstává auditovatelná a vše je na jednom místě.</p>
                </div>
            </div>
        </div>
        <div class="text-center mt-5">
            <a asp-page="/HowItWorks" class="btn btn-spec-primary">Podrobný průvodce systémem</a>
        </div>
    </div>
</section>

<!-- Proč SpecEdu -->
