@page
@model SpecEdu.Web.Public.Pages.IndexModel
@{
    ViewData["Title"] = "Domů";
    ViewData["Description"] = "SpecEdu – digitální složka žáka pro školy, učitele, rodiče a poradenská zařízení (PPP, SPC). Přehledná dokumentace, sdílení doporučení, komunikační deník a notifikace v souladu s GDPR.";
    ViewData["Keywords"] = "specedu, digitální složka žáka, školská poradenská zařízení, PPP, SPC, IVP, dokumentace žáků, GDPR, vzdělávací platforma";
}

@section FullWidthTop {
    <div class="spec-hero-fullbleed">

        <div id="specHero"
             class="carousel slide spec-hero shadow-sm"
             data-bs-ride="carousel"
             data-bs-interval="7000"
             data-bs-pause="hover">

            <div class="carousel-indicators">
                <button type="button" data-bs-target="#specHero" data-bs-slide-to="0"
                        class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#specHero" data-bs-slide-to="1"
                        aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#specHero" data-bs-slide-to="2"
                        aria-label="Slide 3"></button>
            </div>

            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/img/hero-1.png"
                         class="d-block w-100 spec-hero-img"
                         alt="SpecEdu – digitální složka žáka"
                         width="1920" height="800">

                    <div class="spec-hero-overlay"></div>

                    <div class="carousel-caption spec-hero-caption text-start">
                        <div class="spec-hero-badge">SpecEdu</div>
                        <h1 class="spec-hero-title">Digitální složka žáka bez chaosu</h1>
                        <p class="spec-hero-text">
                            Přehledná dokumentace, doporučení a historie poznámek – s přístupem jen pro oprávněné role.
                        </p>

                        <div class="spec-hero-actions">
                            <a class="btn btn-primary btn-lg" asp-page="/Account/Login">Přihlásit se</a>
                            <a class="btn btn-outline-light btn-lg" asp-page="/Contact">Požádat o pilot</a>
                        </div>
                    </div>
                </div>

                <div class="carousel-item">
                    <img src="~/img/hero-2.png"
                         class="d-block w-100 spec-hero-img"
                         alt="SpecEdu – dokumenty a doporučení"
                         width="1920" height="800"
                         loading="lazy">

                    <div class="spec-hero-overlay"></div>

                    <div class="carousel-caption spec-hero-caption text-start">
                        <div class="spec-hero-badge">Dokumenty</div>
                        <h2 class="spec-hero-title">PDF doporučení, zprávy, přílohy – vše na jednom místě</h2>
                        <p class="spec-hero-text">
                            Nahrávání dokumentů, jasná metadata a rychlé dohledání. Připravené i na auditní stopu.
                        </p>

                        <div class="spec-hero-actions">
                            <a class="btn btn-primary btn-lg" asp-page="/HowItWorks">Jak to funguje</a>
                            <button class="btn btn-outline-light btn-lg" disabled>Zobrazit funkce</button>
                        </div>
                    </div>
                </div>

                <div class="carousel-item">
                    <img src="~/img/hero-3.png"
                         class="d-block w-100 spec-hero-img"
                         alt="SpecEdu – komunikační deník a notifikace"
                         width="1920" height="800"
                         loading="lazy">

                    <div class="spec-hero-overlay"></div>

                    <div class="carousel-caption spec-hero-caption text-start">
                        <div class="spec-hero-badge">Spolupráce</div>
                        <h2 class="spec-hero-title">Komunikační deník a termíny kontrol</h2>
                        <p class="spec-hero-text">
                            Jednotné zápisy (telefon, schůzky, spolupráce s rodiči/PPP/SPC) a upozornění na kontrolní vyšetření.
                        </p>

                        <div class="spec-hero-actions">
                            <a class="btn btn-primary btn-lg" asp-page="/Pricing">Zobrazit ceník</a>
                            <a class="btn btn-outline-light btn-lg" asp-page="/Contact">Kontakt</a>
                        </div>
                    </div>
                </div>
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#specHero" data-bs-slide="prev" aria-label="Předchozí">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#specHero" data-bs-slide="next" aria-label="Další">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
            </button>
        </div>

        <div class="container py-3">
            <div class="row g-3 fade-up-stagger">
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm spec-mini-card">
                        <div class="card-body">
                            <div class="spec-mini-title">Přístup jen ke konkrétnímu žákovi</div>
                            <div class="spec-mini-text">
                                Role + vazby na dítě. Rodič vidí jen své dítě, poradna jen přidělené žáky.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm spec-mini-card">
                        <div class="card-body">
                            <div class="spec-mini-title">Dokumenty přehledně</div>
                            <div class="spec-mini-text">
                                Zprávy, doporučení, přílohy. Vždy s datem, autorem a historií.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm spec-mini-card">
                        <div class="card-body">
                            <div class="spec-mini-title">Komunikační deník</div>
                            <div class="spec-mini-text">
                                Poznámky a zápisy ze schůzek na jednom místě, s filtrací a rychlým dohledáním.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
}

<!-- O projektu -->
<section class="container py-5 fade-up">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <h2 class="fw-bold mb-3">Co je SpecEdu?</h2>
            <p class="text-muted mb-3">
                <strong>SpecEdu</strong> je moderní platforma pro správu dokumentace žáků se speciálními vzdělávacími potřebami.
                Spojuje všechny strany, které se podílejí na vzdělávání dítěte – školu, učitele, rodiče a poradenská zařízení (PPP, SPC) –
                a poskytuje jim společné, přehledné a bezpečné prostředí pro komunikaci a sdílení důležitých dokumentů.
            </p>
            <p class="text-muted mb-3">
                Místo papírové dokumentace, e-mailových řetězců a roztříštěných záznamů nabízí SpecEdu jednu digitální složku žáka,
                kde je vše dohledatelné, datované a viditelné jen pro ty, kdo na to mají právo.
                Cílem je snížit administrativní zátěž pedagogů, zlepšit spolupráci s rodiči a poradnami a chránit citlivá data dětí.
            </p>
            <div class="d-flex gap-3 flex-wrap mt-4">
                <a asp-page="/HowItWorks" class="btn btn-spec-primary">Jak to funguje</a>
                <a asp-page="/System/Index" class="btn btn-spec-outline">Více o systému</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="row g-3">
                <div class="col-6">
                    <div class="spec-card p-3 h-100 text-center">
                        <div class="display-5 fw-bold text-spec-primary">100%</div>
                        <div class="small text-muted">v souladu s GDPR</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="spec-card p-3 h-100 text-center">
                        <div class="display-5 fw-bold text-spec-primary">3</div>
                        <div class="small text-muted">jazyky (CZ / EN / DE)</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="spec-card p-3 h-100 text-center">
                        <div class="display-5 fw-bold text-spec-primary">7+</div>
                        <div class="small text-muted">rolí s vlastními oprávněními</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="spec-card p-3 h-100 text-center">
                        <div class="display-5 fw-bold text-spec-primary">24/7</div>
                        <div class="small text-muted">dostupnost služby</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Pro koho je SpecEdu -->
<section class="bg-white py-5 fade-up">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Pro koho je SpecEdu určen?</h2>
            <p class="text-muted">Jeden systém, který šetří čas všem stranám ve vzdělávání dítěte.</p>
        </div>
        <div class="row g-4 fade-up-stagger">
            <div class="col-md-6 col-lg-3">
                <div class="spec-card h-100 p-4 text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <spec-icon name="mortarboard-fill" size="32" class="text-spec-primary"></spec-icon>
                    </div>
                    <h5 class="fw-bold">Školy</h5>
                    <p class="text-muted small mb-0">Snadná evidence, přehled o žácích a méně papírování pro vedení i učitele.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="spec-card h-100 p-4 text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <spec-icon name="people-fill" size="32" class="text-spec-primary"></spec-icon>
                    </div>
                    <h5 class="fw-bold">Učitelé</h5>
                    <p class="text-muted small mb-0">Rychlý přístup k doporučením z PPP/SPC a jednoduché zápisy z jednání.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="spec-card h-100 p-4 text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <spec-icon name="person-plus" size="32" class="text-spec-primary"></spec-icon>
                    </div>
                    <h5 class="fw-bold">Rodiče</h5>
                    <p class="text-muted small mb-0">Vidí pouze své dítě, mají přehled o dokumentaci a kontrolních termínech.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="spec-card h-100 p-4 text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <spec-icon name="file-earmark-richtext" size="32" class="text-spec-primary"></spec-icon>
                    </div>
                    <h5 class="fw-bold">Poradny (PPP, SPC)</h5>
                    <p class="text-muted small mb-0">Sdílení doporučení s konkrétní školou a žákem v jasném, auditovaném prostředí.</p>
                </div>
            </div>
        </div>
    </div>
</section>

