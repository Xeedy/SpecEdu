@page
@model SpecEdu.Web.Public.Pages.PricingModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["PricingPage.Title"];
    ViewData["Description"] = "Transparentní ceník SpecEdu – platforma pro školy a školská poradenská zařízení. Vyberte si tarif podle počtu žáků a požádejte o pilot zdarma.";
}

<!-- Hero -->
<section class="bg-spec-primary-light py-5">
    <div class="container">
        <h1 class="display-5 fw-bold text-center mb-3">@L["PricingPage.Title"]</h1>
        <p class="lead text-center text-muted mb-0">@L["PricingPage.Subtitle"]</p>
    </div>
</section>

<!-- Plan Toggle -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-center mb-5">
            <div class="btn-group" role="group">
                <input type="radio" class="btn-check" name="planType" id="monthly" checked>
                <label class="btn btn-outline-primary" for="monthly">@L["PricingPage.Monthly"]</label>
                <input type="radio" class="btn-check" name="planType" id="yearly">
                <label class="btn btn-outline-primary" for="yearly">@L["PricingPage.Yearly"] <span class="badge bg-success">-20%</span></label>
            </div>
        </div>

        <!-- Pricing Cards -->
        <div class="row g-4 justify-content-center">
            <!-- Pilot -->
            <div class="col-md-6 col-lg-4">
                <div class="spec-card h-100 p-4">
                    <div class="text-center mb-4">
                        <h4 class="fw-bold">@L["PricingPage.PilotTitle"]</h4>
                        <p class="text-muted small mb-3">@L["PricingPage.PilotDesc"]</p>
                        <div class="display-4 fw-bold text-spec-primary">@L["PricingPage.Free"]</div>
                        <p class="text-muted small">@L["PricingPage.PilotDuration"]</p>
                    </div>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.PilotFeature1"]</li>
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.PilotFeature2"]</li>
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.PilotFeature3"]</li>
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.PilotFeature4"]</li>
                        <li class="mb-2 text-muted"><span class="me-2">-</span> @L["PricingPage.PilotFeature5"]</li>
                    </ul>
                    <a asp-page="/Contact" class="btn btn-spec-outline w-100">@L["PricingPage.RequestPilot"]</a>
                </div>
            </div>

            <!-- Standard -->
            <div class="col-md-6 col-lg-4">
                <div class="spec-card h-100 p-4 border-primary border-2 position-relative">
                    <div class="position-absolute top-0 start-50 translate-middle">
                        <span class="badge bg-spec-primary px-3 py-2">@L["PricingPage.Popular"]</span>
                    </div>
                    <div class="text-center mb-4 pt-3">
                        <h4 class="fw-bold">@L["PricingPage.StandardTitle"]</h4>
                        <p class="text-muted small mb-3">@L["PricingPage.StandardDesc"]</p>
                        <div class="display-4 fw-bold text-spec-primary">990 Kc</div>
                        <p class="text-muted small">@L["PricingPage.PerMonth"]</p>
                    </div>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.StandardFeature1"]</li>
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.StandardFeature2"]</li>
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.StandardFeature3"]</li>
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.StandardFeature4"]</li>
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.StandardFeature5"]</li>
                    </ul>
                    <a asp-page="/Account/Register" class="btn btn-spec-primary w-100">@L["PricingPage.StartNow"]</a>
                </div>
            </div>

            <!-- Enterprise -->
            <div class="col-md-6 col-lg-4">
                <div class="spec-card h-100 p-4">
                    <div class="text-center mb-4">
                        <h4 class="fw-bold">@L["PricingPage.EnterpriseTitle"]</h4>
                        <p class="text-muted small mb-3">@L["PricingPage.EnterpriseDesc"]</p>
                        <div class="display-4 fw-bold text-spec-primary">@L["PricingPage.Custom"]</div>
                        <p class="text-muted small">@L["PricingPage.ContactUs"]</p>
                    </div>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.EnterpriseFeature1"]</li>
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.EnterpriseFeature2"]</li>
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.EnterpriseFeature3"]</li>
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.EnterpriseFeature4"]</li>
                        <li class="mb-2"><span class="text-success me-2">&#10003;</span> @L["PricingPage.EnterpriseFeature5"]</li>
                    </ul>
                    <a asp-page="/Contact" class="btn btn-spec-outline w-100">@L["PricingPage.ContactSales"]</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- What's Included -->
<section class="bg-white py-5">
    <div class="container">
        <h2 class="fw-bold text-center mb-5">@L["PricingPage.IncludedTitle"]</h2>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <spec-icon name="gear-wide-connected" size="28" class="text-spec-primary"></spec-icon>
                    </div>
                    <h6 class="fw-bold">@L["PricingPage.Included1Title"]</h6>
                    <p class="text-muted small mb-0">@L["PricingPage.Included1Desc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <spec-icon name="headset" size="28" class="text-spec-primary"></spec-icon>
                    </div>
                    <h6 class="fw-bold">@L["PricingPage.Included2Title"]</h6>
                    <p class="text-muted small mb-0">@L["PricingPage.Included2Desc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <spec-icon name="bookmark" size="28" class="text-spec-primary"></spec-icon>
                    </div>
                    <h6 class="fw-bold">@L["PricingPage.Included3Title"]</h6>
                    <p class="text-muted small mb-0">@L["PricingPage.Included3Desc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <spec-icon name="info-circle" size="28" class="text-spec-primary"></spec-icon>
                    </div>
                    <h6 class="fw-bold">@L["PricingPage.Included4Title"]</h6>
                    <p class="text-muted small mb-0">@L["PricingPage.Included4Desc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FAQ -->
<section class="py-5">
    <div class="container">
        <h2 class="fw-bold text-center mb-5">@L["PricingPage.FaqTitle"]</h2>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="accordion" id="pricingFaq">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                @L["PricingPage.Faq1Question"]
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#pricingFaq">
                            <div class="accordion-body">@L["PricingPage.Faq1Answer"]</div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                @L["PricingPage.Faq2Question"]
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#pricingFaq">
                            <div class="accordion-body">@L["PricingPage.Faq2Answer"]</div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                @L["PricingPage.Faq3Question"]
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#pricingFaq">
                            <div class="accordion-body">@L["PricingPage.Faq3Answer"]</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
