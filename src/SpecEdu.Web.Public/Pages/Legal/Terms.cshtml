@page
@model SpecEdu.Web.Public.Pages.Legal.TermsModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["TermsPage.Title"];
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="fw-bold mb-4">@L["TermsPage.Title"]</h1>
                <p class="text-muted mb-4">@L["TermsPage.LastUpdated"]: 1. 1. 2026</p>

                <div class="spec-card p-4 mb-4">
                    <h4 class="fw-bold">1. @L["TermsPage.Section1Title"]</h4>
                    <p class="text-muted">@L["TermsPage.Section1Content"]</p>
                </div>

                <div class="spec-card p-4 mb-4">
                    <h4 class="fw-bold">2. @L["TermsPage.Section2Title"]</h4>
                    <p class="text-muted">@L["TermsPage.Section2Content"]</p>
                    <ul class="text-muted">
                        <li>@L["TermsPage.Section2Point1"]</li>
                        <li>@L["TermsPage.Section2Point2"]</li>
                        <li>@L["TermsPage.Section2Point3"]</li>
                    </ul>
                </div>

                <div class="spec-card p-4 mb-4">
                    <h4 class="fw-bold">3. @L["TermsPage.Section3Title"]</h4>
                    <p class="text-muted">@L["TermsPage.Section3Content"]</p>
                </div>

                <div class="spec-card p-4 mb-4">
                    <h4 class="fw-bold">4. @L["TermsPage.Section4Title"]</h4>
                    <p class="text-muted">@L["TermsPage.Section4Content"]</p>
                </div>

                <div class="spec-card p-4 mb-4">
                    <h4 class="fw-bold">5. @L["TermsPage.Section5Title"]</h4>
                    <p class="text-muted">@L["TermsPage.Section5Content"]</p>
                </div>

                <div class="spec-card p-4">
                    <h4 class="fw-bold">6. @L["TermsPage.Section6Title"]</h4>
                    <p class="text-muted mb-0">@L["TermsPage.Section6Content"]</p>
                </div>
            </div>
        </div>
    </div>
</section>
