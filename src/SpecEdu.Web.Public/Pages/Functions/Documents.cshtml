@page
@model SpecEdu.Web.Public.Pages.Functions.DocumentsModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["DocumentsPage.Title"];
    ViewData["Description"] = "Správa dokumentů ve SpecEdu – PDF doporučení, zprávy a přílohy s jasnými metadaty, datem a autorem. Vše dohledatelné.";
}

<!-- Hero -->
<section class="bg-spec-primary-light py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="badge bg-spec-primary mb-3">@L["DocumentsPage.Badge"]</span>
                <h1 class="display-5 fw-bold mb-3">@L["DocumentsPage.Title"]</h1>
                <p class="lead text-muted mb-4">@L["DocumentsPage.Subtitle"]</p>
                <a asp-page="/Account/Register" class="btn btn-spec-primary btn-lg">@L["Common.TryFree"]</a>
            </div>
            <div class="col-lg-6 mt-4 mt-lg-0">
                <img src="~/img/documents-hero.jpg"
                     alt="@L["DocumentsPage.Title"]" class="img-fluid rounded shadow-lg" width="600" height="400">
            </div>
        </div>
    </div>
</section>

<!-- Document Types -->
<section class="py-5">
    <div class="container">
        <h2 class="fw-bold text-center mb-5">@L["DocumentsPage.TypesTitle"]</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <spec-icon name="file-earmark-medical" size="40"></spec-icon>
                    </div>
                    <h5 class="fw-bold">@L["DocumentsPage.Type1Title"]</h5>
                    <p class="text-muted mb-0">@L["DocumentsPage.Type1Desc"]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <spec-icon name="file-earmark-text" size="40"></spec-icon>
                    </div>
                    <h5 class="fw-bold">@L["DocumentsPage.Type2Title"]</h5>
                    <p class="text-muted mb-0">@L["DocumentsPage.Type2Desc"]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <spec-icon name="info-circle-fill" size="40"></spec-icon>
                    </div>
                    <h5 class="fw-bold">@L["DocumentsPage.Type3Title"]</h5>
                    <p class="text-muted mb-0">@L["DocumentsPage.Type3Desc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How it works -->
<section class="bg-white py-5">
    <div class="container">
        <h2 class="fw-bold text-center mb-5">@L["DocumentsPage.HowItWorksTitle"]</h2>
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="d-flex flex-column flex-md-row justify-content-between">
                    <div class="text-center mb-4 mb-md-0 flex-fill">
                        <div class="bg-spec-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">1</div>
                        <h6 class="fw-bold">@L["DocumentsPage.Step1Title"]</h6>
                        <p class="text-muted small mb-0">@L["DocumentsPage.Step1Desc"]</p>
                    </div>
                    <div class="d-none d-md-flex align-items-center px-3">
                        <spec-icon name="arrow-right" size="24" style="color: var(--spec-gray-400);"></spec-icon>
                    </div>
                    <div class="text-center mb-4 mb-md-0 flex-fill">
                        <div class="bg-spec-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">2</div>
                        <h6 class="fw-bold">@L["DocumentsPage.Step2Title"]</h6>
                        <p class="text-muted small mb-0">@L["DocumentsPage.Step2Desc"]</p>
                    </div>
                    <div class="d-none d-md-flex align-items-center px-3">
                        <spec-icon name="arrow-right" size="24" style="color: var(--spec-gray-400);"></spec-icon>
                    </div>
                    <div class="text-center flex-fill">
                        <div class="bg-spec-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">3</div>
                        <h6 class="fw-bold">@L["DocumentsPage.Step3Title"]</h6>
                        <p class="text-muted small mb-0">@L["DocumentsPage.Step3Desc"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
