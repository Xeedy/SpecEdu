@page
@model SpecEdu.Web.Public.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Heslo obnoveno";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="text-center mb-4">
                <div class="mb-3">
                    <i class="bi bi-check-circle display-1 text-success"></i>
                </div>
                <h1 class="mb-2">Heslo bylo obnoveno</h1>
                <p class="text-muted">
                    Vase heslo bylo uspesne zmeneno.
                </p>
            </div>

            <div class="spec-card">
                <div class="spec-card-body text-center">
                    <p class="mb-3">
                        Nyni se muzete prihlasit s novym heslem.
                    </p>
                    <a asp-page="/Account/Login" class="btn btn-spec-primary">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Prejit na prihlaseni
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
