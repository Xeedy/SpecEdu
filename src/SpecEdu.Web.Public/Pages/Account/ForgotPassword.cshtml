@page
@model SpecEdu.Web.Public.Pages.Account.ForgotPasswordModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = "Zapomenute heslo";
    ViewData["NoIndex"] = true;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="text-center mb-4">
                <h1 class="mb-2">@L["ForgotPasswordPage.ForgotPassword"]</h1>
                <p class="text-muted">@L["ForgotPasswordPage.EnterEmail"]</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            <div class="spec-card">
                <div class="spec-card-body">
                    <form method="post" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <input type="email" class="form-control" asp-for="Input.Email"
                                   placeholder="vas@email.cz" required autofocus />
                            <span class="text-danger" asp-validation-for="Input.Email"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-spec-primary">
                                <i class="bi bi-envelope me-2"></i>@L["ForgotPasswordPage.SendLink"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-3">
                <a asp-page="/Account/Login" class="text-muted small">
                    <i class="bi bi-arrow-left me-1"></i>@L["ForgotPasswordPage.BackToLogin"]
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ForgotPassword.js" asp-append-version="true"></script>
}
