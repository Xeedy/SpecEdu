@page
@model SpecEdu.Web.Public.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Potvrzeni odeslani";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="text-center mb-4">
                <div class="mb-3">
                    <i class="bi bi-envelope-check display-1 text-success"></i>
                </div>
                <h1 class="mb-2">E-mail odeslan</h1>
                <p class="text-muted">
                    Pokud je zadany e-mail registrovan v nasem systemu, obdrzite brzy odkaz pro obnoveni hesla.
                </p>
            </div>

            <div class="spec-card">
                <div class="spec-card-body text-center">
                    <p class="mb-3">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        Zkontrolujte svou e-mailovou schranku vcetne slozky se spamem.
                    </p>
                    <p class="text-muted small mb-0">
                        Odkaz pro obnoveni hesla je platny 24 hodin.
                    </p>
                </div>
            </div>

            <div class="text-center mt-3">
                <a asp-page="/Account/Login" class="text-muted small">
                    <i class="bi bi-arrow-left me-1"></i>Zpet na prihlaseni
                </a>
            </div>

        </div>
    </div>
</div>
