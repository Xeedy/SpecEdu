@page
@model SpecEdu.Web.App.Pages.Account.SettingsModel
@inject IStringLocalizer<SpecEdu.Web.App.SharedResource> L
@{
    ViewData["Title"] = L["SettingsPage.Title"];
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = "/Account/Settings";
}

<section class="py-5">
    <div class="container">
        <h1 class="fw-bold mb-4">@L["SettingsPage.Title"]</h1>

        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                @L[successMsg]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMsg)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                @L[errorMsg]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row">
            <div class="col-lg-3 mb-4 mb-lg-0">
                <!-- Settings Navigation -->
                <div class="spec-card p-0">
                    <div class="list-group list-group-flush">
                        <a href="#password" class="list-group-item list-group-item-action active">
                            @L["SettingsPage.PasswordChange"]
                        </a>
                        <a href="#language" class="list-group-item list-group-item-action">
                            @L["SettingsPage.Language"]
                        </a>
                        <a href="#general" class="list-group-item list-group-item-action">
                            @L["SettingsPage.General"]
                        </a>
                        <a href="#notifications" class="list-group-item list-group-item-action">
                            @L["SettingsPage.Notifications"]
                        </a>
                        <a href="#privacy" class="list-group-item list-group-item-action">
                            @L["SettingsPage.Privacy"]
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                <!-- Password Change -->
                <div class="spec-card p-4 mb-4" id="password">
                    <h4 class="fw-bold mb-4">@L["SettingsPage.PasswordChange"]</h4>
                    <form method="post" asp-page-handler="ChangePassword">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="PasswordInput.CurrentPassword" class="form-label">@L["SettingsPage.CurrentPassword"]</label>
                                <input asp-for="PasswordInput.CurrentPassword" class="form-control" />
                                <span asp-validation-for="PasswordInput.CurrentPassword" class="text-danger"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="PasswordInput.NewPassword" class="form-label">@L["SettingsPage.NewPassword"]</label>
                                <input asp-for="PasswordInput.NewPassword" class="form-control" />
                                <span asp-validation-for="PasswordInput.NewPassword" class="text-danger"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="PasswordInput.ConfirmPassword" class="form-label">@L["SettingsPage.ConfirmPassword"]</label>
                                <input asp-for="PasswordInput.ConfirmPassword" class="form-control" />
                                <span asp-validation-for="PasswordInput.ConfirmPassword" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-spec-primary">@L["SettingsPage.ChangePasswordBtn"]</button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Language Settings -->
                <div class="spec-card p-4 mb-4" id="language">
                    <h4 class="fw-bold mb-4">@L["SettingsPage.LanguageSettings"]</h4>
                    <div class="d-flex gap-2">
                        <a asp-page="/Culture/Set"
                           asp-route-culture="cs"
                           asp-route-returnUrl="@returnUrl"
                           class="btn @(currentCulture == "cs" ? "btn-spec-primary" : "btn-spec-outline")">
                            Cestina
                        </a>
                        <a asp-page="/Culture/Set"
                           asp-route-culture="en"
                           asp-route-returnUrl="@returnUrl"
                           class="btn @(currentCulture == "en" ? "btn-spec-primary" : "btn-spec-outline")">
                            English
                        </a>
                        <a asp-page="/Culture/Set"
                           asp-route-culture="de"
                           asp-route-returnUrl="@returnUrl"
                           class="btn @(currentCulture == "de" ? "btn-spec-primary" : "btn-spec-outline")">
                            Deutsch
                        </a>
                    </div>
                </div>

                <!-- General Settings -->
                <div class="spec-card p-4 mb-4" id="general">
                    <h4 class="fw-bold mb-4">@L["SettingsPage.General"]</h4>
                    <div class="mb-4">
                        <label class="form-label">@L["SettingsPage.Timezone"]</label>
                        <select class="form-select" disabled>
                            <option selected>Europe/Prague (UTC+1)</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">@L["SettingsPage.DateFormat"]</label>
                        <select class="form-select" disabled>
                            <option selected>DD.MM.YYYY</option>
                        </select>
                    </div>
                </div>

                <!-- Notification Settings -->
                <div class="spec-card p-4 mb-4" id="notifications">
                    <h4 class="fw-bold mb-4">@L["SettingsPage.NotificationSettings"]</h4>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" checked disabled>
                        <label class="form-check-label">@L["SettingsPage.EmailNotifications"]</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" checked disabled>
                        <label class="form-check-label">@L["SettingsPage.DocumentNotifications"]</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" disabled>
                        <label class="form-check-label">@L["SettingsPage.MarketingNotifications"]</label>
                    </div>
                </div>

                <!-- Privacy & Data -->
                <div class="spec-card p-4 mb-4" id="privacy">
                    <h4 class="fw-bold mb-4">@L["SettingsPage.PrivacyTitle"]</h4>
                    <p class="text-muted mb-3">@L["SettingsPage.PrivacyDesc"]</p>
                    <a asp-page="/Account/DataExport" class="btn btn-spec-outline">
                        <i class="bi bi-download me-2"></i>@L["SettingsPage.DownloadMyData"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
