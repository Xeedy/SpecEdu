@page "{id:guid}"
@model SpecEdu.Web.App.Pages.MyChildren.ChildDiaryModel
@inject IStringLocalizer<SpecEdu.Web.App.SharedResource> L
@{
    ViewData["Title"] = $"{L["DiaryPage.Title"]} - {Model.Child.FullName}";
}

<section class="py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1><i class="bi bi-journal-text me-2"></i>@L["DiaryPage.Title"]</h1>
                <p class="text-muted mb-0">@Model.Child.FullName</p>
            </div>
        </div>

        <!-- Filters -->
        <div class="spec-card mb-4">
            <div class="spec-card-body p-3">
                <form method="get" class="row g-3 align-items-end">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="col-md-4">
                        <label class="form-label">@L["DiaryPage.FilterType"]</label>
                        <select class="form-select" name="FilterType" asp-items="Model.EntryTypeOptions">
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-spec-primary">
                            <i class="bi bi-funnel me-2"></i>@L["Common.Filter"]
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Timeline -->
        <div class="spec-card">
            <div class="spec-card-body p-4">
                @if (Model.Entries.Any())
                {
                    <div class="timeline">
                        @foreach (var entry in Model.Entries)
                        {
                            <div class="timeline-item mb-4 pb-4 border-bottom">
                                <div class="d-flex">
                                    <div class="timeline-icon me-3">
                                        <div class="rounded-circle bg-@Model.GetEntryTypeColor(entry.Type) d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi @Model.GetEntryTypeIcon(entry.Type) text-white"></i>
                                        </div>
                                    </div>
                                    <div class="timeline-content flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h5 class="mb-1">@entry.Title</h5>
                                                <span class="badge bg-@Model.GetEntryTypeColor(entry.Type)">@Model.GetEntryTypeName(entry.Type)</span>
                                            </div>
                                            <div class="text-end">
                                                <div class="text-muted small">
                                                    @entry.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                                </div>
                                                @if (entry.OccurredAt.HasValue && entry.OccurredAt.Value.Date != entry.CreatedAt.Date)
                                                {
                                                    <div class="text-muted small">
                                                        <i class="bi bi-calendar-event me-1"></i>@entry.OccurredAt.Value.ToString("dd.MM.yyyy")
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <p class="mb-2">@entry.Content</p>
                                        <small class="text-muted">
                                            <i class="bi bi-person me-1"></i>@(entry.CreatedByName ?? "")
                                            @if (entry.AttachmentCount > 0)
                                            {
                                                <span class="ms-2">
                                                    <i class="bi bi-paperclip me-1"></i>@entry.AttachmentCount @L["DiaryPage.Attachments"]
                                                </span>
                                            }
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation" class="mt-4">
                            <ul class="pagination justify-content-center mb-0">
                                @for (var i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-page="ChildDiary"
                                           asp-route-id="@Model.Id"
                                           asp-route-currentpage="@i"
                                           asp-route-filtertype="@Model.FilterType">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-journal-x display-1 text-muted"></i>
                        <p class="text-muted mt-3 mb-0">@L["DiaryPage.NoEntries"]</p>
                    </div>
                }
            </div>
        </div>

        <div class="mt-3">
            <a asp-page="ChildDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>@L["Common.BackToDetails"]
            </a>
        </div>
    </div>
</section>

<style>
    .timeline-item:last-child {
        border-bottom: none !important;
        margin-bottom: 0 !important;
        padding-bottom: 0 !important;
    }
</style>
