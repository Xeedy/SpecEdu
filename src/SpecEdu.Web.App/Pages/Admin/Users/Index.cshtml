@page
@model SpecEdu.Web.App.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Správa uživatelů";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Správa uživatelů</h1>
        <a asp-page="Create" class="btn btn-spec-primary">Přidat uživatele</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
        </div>
    }

    <div class="spec-card">
        <div class="spec-card-body">
            @if (Model.Users.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>E-mail</th>
                                <th>Jméno</th>
                                <th>Role</th>
                                <th>Škola</th>
                                <th>Stav</th>
                                <th>Vytvořen</th>
                                <th class="text-end">Akce</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>@user.Email</td>
                                    <td><strong>@user.FullName</strong></td>
                                    <td>
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="badge bg-primary me-1">@role</span>
                                        }
                                    </td>
                                    <td>@(user.SchoolName ?? "-")</td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Aktivní</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Neaktivní</span>
                                        }
                                    </td>
                                    <td>@user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                    <td class="text-end">
                                        <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-spec-outline">Upravit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted mb-3">Zatím nejsou registrováni žádní uživatelé.</p>
                    <a asp-page="Create" class="btn btn-spec-primary">Přidat prvního uživatele</a>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="/Admin/Index" class="btn btn-outline-secondary">Zpět na administraci</a>
    </div>
</div>
