@page "{id}"
@model SpecEdu.Web.App.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Upravit uživatele";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <h1 class="mb-4">Upravit uživatele</h1>

            @if (Model.UserDto != null)
            {
                <p class="text-muted mb-4">
                    <strong>E-mail:</strong> @Model.UserDto.Email
                    &middot;
                    <strong>Škola:</strong> @(Model.UserDto.SchoolName ?? "Bez školy")
                    &middot;
                    <strong>Vytvořen:</strong> @Model.UserDto.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="spec-card">
                <div class="spec-card-header">Základní údaje</div>
                <div class="spec-card-body">
                    <form method="post" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="Input.Id" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Jméno <span class="text-danger">*</span></label>
                                <input class="form-control" asp-for="Input.FirstName" required />
                                <span class="text-danger" asp-validation-for="Input.FirstName"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Příjmení <span class="text-danger">*</span></label>
                                <input class="form-control" asp-for="Input.LastName" required />
                                <span class="text-danger" asp-validation-for="Input.LastName"></span>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Input.IsActive" />
                                    <label class="form-check-label" asp-for="Input.IsActive">Aktivní účet</label>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div class="col-12">
                                <label class="form-label">Role</label>
                                <div class="d-flex flex-wrap gap-3">
                                    @foreach (var role in Model.AvailableRoles)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   name="SelectedRoles" value="@role.Value"
                                                   id="role_@role.Value"
                                                   @(Model.SelectedRoles.Contains(role.Value) ? "checked" : "") />
                                            <label class="form-check-label" for="role_@role.Value">@role.Label</label>
                                        </div>
                                    }
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div class="col-md-6">
                                <label class="form-label">Nové heslo</label>
                                <input type="password" class="form-control" asp-for="NewPassword"
                                       placeholder="Ponechte prázdné pro zachování" />
                                <div class="form-text">Vyplňte pouze pokud chcete resetovat heslo.</div>
                            </div>

                            <div class="col-12 d-flex gap-2 flex-wrap mt-3">
                                <button type="submit" class="btn btn-spec-primary">Uložit změny</button>
                                <a asp-page="Index" class="btn btn-outline-secondary">Zrušit</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}
