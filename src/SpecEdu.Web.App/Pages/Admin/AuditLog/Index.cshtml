@page
@model SpecEdu.Web.App.Pages.Admin.AuditLog.IndexModel
@{
    ViewData["Title"] = "Audit log";
}

<div class="container py-4">
    <h1 class="mb-4">Audit log</h1>

    <div class="spec-card mb-4">
        <div class="spec-card-header">Filtrování</div>
        <div class="spec-card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Od</label>
                    <input type="date" class="form-control" asp-for="FromDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Do</label>
                    <input type="date" class="form-control" asp-for="ToDate" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-spec-primary">Filtrovat</button>
                    <a asp-page="Index" class="btn btn-outline-secondary">Zrušit filtr</a>
                </div>
            </form>
        </div>
    </div>

    <div class="spec-card">
        <div class="spec-card-header">
            Záznamy
            <span class="text-muted ms-2">(celkem @Model.TotalCount)</span>
        </div>
        <div class="spec-card-body">
            @if (Model.Logs.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Čas</th>
                                <th>Uživatel</th>
                                <th>Akce</th>
                                <th>Typ entity</th>
                                <th>Detaily</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.Logs)
                            {
                                <tr>
                                    <td class="text-nowrap">@log.TimestampFormatted</td>
                                    <td>@(log.UserName ?? log.UserId ?? "-")</td>
                                    <td>
                                        <span class="badge bg-info">@log.ActionName</span>
                                    </td>
                                    <td>@log.EntityType</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(log.Details))
                                        {
                                            <span class="text-truncate d-inline-block" style="max-width: 300px;" title="@log.Details">
                                                @log.Details
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-3" aria-label="Stránkování">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-page="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                   asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Předchozí</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-page="Index"
                                       asp-route-page="@i"
                                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-page="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                   asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Další</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted">Nebyly nalezeny žádné záznamy pro dané filtry.</p>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="/Admin/Index" class="btn btn-outline-secondary">Zpět na administraci</a>
    </div>
</div>
