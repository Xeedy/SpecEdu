@page
@model SpecEdu.Web.App.Pages.Dashboard.IndexModel
@inject IStringLocalizer<SpecEdu.Web.App.SharedResource> L
@{
    ViewData["Title"] = L["DashboardPage.Title"];
}

<section class="py-4">
    <div class="container">
        <!-- Welcome -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold mb-1">@L["DashboardPage.Welcome"], @User.Identity?.Name!</h1>
                <p class="text-muted mb-0">@L["DashboardPage.WelcomeDesc"]</p>
            </div>
            <div class="text-muted">
                @DateTime.Now.ToString("dddd, d. MMMM yyyy")
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-4 mb-4">
            <div class="col-md-6 col-lg-3">
                <div class="spec-card p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">@L["DashboardPage.TotalStudents"]</p>
                            <h3 class="fw-bold mb-0">@Model.StudentCount</h3>
                        </div>
                        <div class="bg-spec-primary-light rounded p-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="var(--spec-primary)" viewBox="0 0 16 16">
                                <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1h8zm-7.978-1A.261.261 0 0 1 7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002a.274.274 0 0 1-.014.002H7.022zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM6.936 9.28a5.88 5.88 0 0 0-1.23-.247A7.35 7.35 0 0 0 5 9c-4 0-5 3-5 4 0 .667.333 1 1 1h4.216A2.238 2.238 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816zM4.92 10A5.493 5.493 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275zM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0zm3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="mt-2">
                        <span class="text-success small">+12%</span>
                        <span class="text-muted small">@L["DashboardPage.FromLastMonth"]</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="spec-card p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">@L["DashboardPage.ActiveDocuments"]</p>
                            <h3 class="fw-bold mb-0">48</h3>
                        </div>
                        <div class="bg-spec-primary-light rounded p-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="var(--spec-primary)" viewBox="0 0 16 16">
                                <path d="M9.293 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.707A1 1 0 0 0 13.707 4L10 .293A1 1 0 0 0 9.293 0z"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="spec-card p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">@L["DashboardPage.PendingTasks"]</p>
                            <h3 class="fw-bold mb-0">7</h3>
                        </div>
                        <div class="bg-warning bg-opacity-25 rounded p-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="var(--spec-warning)" viewBox="0 0 16 16">
                                <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2z"/>
                                <path d="M8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917z"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="spec-card p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">@L["DashboardPage.Messages"]</p>
                            <h3 class="fw-bold mb-0">3</h3>
                        </div>
                        <div class="bg-spec-primary-light rounded p-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="var(--spec-primary)" viewBox="0 0 16 16">
                                <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1h12z"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Recent Activity -->
            <div class="col-lg-8">
                <div class="spec-card p-4">
                    <h5 class="fw-bold mb-4">@L["DashboardPage.RecentActivity"]</h5>
                    <div class="list-group list-group-flush">
                        <div class="list-group-item px-0 d-flex align-items-start">
                            <div class="bg-success rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 36px; height: 36px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="white" viewBox="0 0 16 16">
                                    <path d="M9.293 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.707A1 1 0 0 0 13.707 4L10 .293A1 1 0 0 0 9.293 0z"/>
                                </svg>
                            </div>
                            <div class="flex-grow-1">
                                <p class="mb-1"><strong>@L["DashboardPage.Activity1"]</strong></p>
                                <small class="text-muted">2 @L["DashboardPage.HoursAgo"]</small>
                            </div>
                        </div>
                        <div class="list-group-item px-0 d-flex align-items-start">
                            <div class="bg-spec-primary rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 36px; height: 36px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="white" viewBox="0 0 16 16">
                                    <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1h12z"/>
                                </svg>
                            </div>
                            <div class="flex-grow-1">
                                <p class="mb-1"><strong>@L["DashboardPage.Activity2"]</strong></p>
                                <small class="text-muted">5 @L["DashboardPage.HoursAgo"]</small>
                            </div>
                        </div>
                        <div class="list-group-item px-0 d-flex align-items-start">
                            <div class="bg-warning rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 36px; height: 36px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="white" viewBox="0 0 16 16">
                                    <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2z"/>
                                </svg>
                            </div>
                            <div class="flex-grow-1">
                                <p class="mb-1"><strong>@L["DashboardPage.Activity3"]</strong></p>
                                <small class="text-muted">1 @L["DashboardPage.DayAgo"]</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="col-lg-4">
                <div class="spec-card p-4">
                    <h5 class="fw-bold mb-4">@L["DashboardPage.QuickActions"]</h5>
                    <div class="d-grid gap-2">
                        @if (User.IsInRole("SchoolAdmin"))
                        {
                            <a asp-page="/SchoolAdmin/Students/Create" class="btn btn-spec-primary">@L["DashboardPage.AddStudent"]</a>
                        }
                        else
                        {
                            <button class="btn btn-spec-primary" disabled>@L["DashboardPage.AddStudent"]</button>
                        }
                        @if (User.IsInRole("SchoolAdmin"))
                        {
                            <a asp-page="/SchoolAdmin/Calendar/Index" class="btn btn-spec-outline">
                                <i class="bi bi-calendar3 me-1"></i>@L["DashboardPage.ViewCalendar"]
                            </a>
                            <a asp-page="/SchoolAdmin/Calendar/Create" class="btn btn-spec-outline">
                                <i class="bi bi-plus-lg me-1"></i>@L["DashboardPage.CreateConsultation"]
                            </a>
                        }
                        else if (User.IsInRole("Parent"))
                        {
                            <a asp-page="/MyChildren/Calendar" class="btn btn-spec-outline">
                                <i class="bi bi-calendar3 me-1"></i>@L["DashboardPage.ViewCalendar"]
                            </a>
                        }
                        else
                        {
                            <a asp-page="/Dashboard/Calendar" class="btn btn-spec-outline">
                                <i class="bi bi-calendar3 me-1"></i>@L["DashboardPage.ViewCalendar"]
                            </a>
                        }
                        <button class="btn btn-spec-outline" disabled>@L["DashboardPage.CreateDocument"]</button>
                        <button class="btn btn-spec-outline" disabled>@L["DashboardPage.SendMessage"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
