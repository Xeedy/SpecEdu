@page
@model SpecEdu.Web.App.Pages.SchoolAdmin.Calendar.IndexModel
@using SpecEdu.Web.App.Pages.SchoolAdmin.Calendar
@inject IStringLocalizer<SpecEdu.Web.App.SharedResource> L
@{
    ViewData["Title"] = L["CalendarPage.Title"];
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1><i class="bi bi-calendar3 me-2"></i>@L["CalendarPage.Title"]</h1>
            <p class="text-muted mb-0">@L["CalendarPage.Subtitle"]</p>
        </div>
        <div class="d-flex gap-2">
            <!-- Sidebar toggle for tablet/mobile -->
            <button class="btn btn-outline-secondary btn-calendar-sidebar-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#calendarSidebar">
                <i class="bi bi-layout-sidebar-reverse"></i>
            </button>
            <a asp-page="Create" class="btn btn-spec-primary">
                <i class="bi bi-plus-lg me-2"></i>@L["CalendarPage.NewEvent"]
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Calendar -->
        <div class="col-lg-9">
            <div class="spec-card">
                <div class="spec-card-body">
                    <div class="calendar-wrapper">
                        <div id="calendar"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar - Desktop (lg+) -->
        <div class="col-lg-3 d-none d-lg-block">
            @await Html.PartialAsync("_CalendarSidebarContent", Model)
        </div>
    </div>
</div>

<!-- Sidebar - Offcanvas (tablet/mobile) -->
<div class="offcanvas offcanvas-end d-lg-none" tabindex="-1" id="calendarSidebar" aria-labelledby="calendarSidebarLabel">
    <div class="offcanvas-header">
        <h5 id="calendarSidebarLabel">@L["CalendarPage.UpcomingAndLegend"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        @await Html.PartialAsync("_CalendarSidebarContent", Model)
    </div>
</div>

@await Html.PartialAsync("_CalendarEventModal")

@section Styles {
    <style>
        /* Purple badge for Counselor type (not in Bootstrap) */
        .text-bg-purple { background-color: #6f42c1 !important; color: #fff !important; }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script src="~/js/calendar-common.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            SpecEduCalendar.init({
                elementId: 'calendar',
                eventsUrl: '@Url.Page("Index", "Events")',
                locale: '@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName',
                isAdmin: true,
                detailsBaseUrl: '@Url.Page("Details")',
                editBaseUrl: '@Url.Page("Edit")',
                createUrl: '@Url.Page("Create")',
                labels: {
                    today: '@L["CalendarPage.Today"]',
                    month: '@L["CalendarPage.Month"]',
                    week:  '@L["CalendarPage.Week"]',
                    day:   '@L["CalendarPage.Day"]',
                    list:  '@L["CalendarPage.List"]',
                    type_0: '@L["CalendarPage.TypeParentTeacher"]',
                    type_1: '@L["CalendarPage.TypeIndividual"]',
                    type_2: '@L["CalendarPage.TypePlppReview"]',
                    type_3: '@L["CalendarPage.TypeIvpReview"]',
                    type_4: '@L["CalendarPage.TypeCounselor"]',
                    type_5: '@L["CalendarPage.TypeExternal"]',
                    type_6: '@L["CalendarPage.TypeSchoolEvent"]',
                    type_7: '@L["CalendarPage.TypeOther"]',
                    status_0: '@L["CalendarPage.StatusScheduled"]',
                    status_1: '@L["CalendarPage.StatusConfirmed"]',
                    status_2: '@L["CalendarPage.StatusCompleted"]',
                    status_3: '@L["CalendarPage.StatusCancelled"]',
                    status_4: '@L["CalendarPage.StatusRescheduled"]'
                }
            });
        });
    </script>
}
