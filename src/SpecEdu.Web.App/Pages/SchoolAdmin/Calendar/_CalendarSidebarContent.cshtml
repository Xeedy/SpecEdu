@model SpecEdu.Web.App.Pages.SchoolAdmin.Calendar.IndexModel
@inject IStringLocalizer<SpecEdu.Web.App.SharedResource> L

<!-- Upcoming Events -->
<div class="spec-card">
    <div class="spec-card-header">
        <h5 class="mb-0"><i class="bi bi-clock me-2"></i>@L["CalendarPage.UpcomingEvents"]</h5>
    </div>
    <div class="spec-card-body">
        @if (Model.UpcomingEvents.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var evt in Model.UpcomingEvents)
                {
                    <a asp-page="Details" asp-route-id="@evt.Id" class="list-group-item list-group-item-action px-0">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="mb-1">@evt.Title</h6>
                                <small class="text-muted">
                                    <i class="bi bi-calendar me-1"></i>@evt.StartTime.ToString("dd.MM. HH:mm")
                                </small>
                                @if (!string.IsNullOrEmpty(evt.StudentName))
                                {
                                    <br />
                                    <small class="text-muted">
                                        <i class="bi bi-person me-1"></i>@evt.StudentName
                                    </small>
                                }
                            </div>
                            <span class="badge @IndexModel.GetStatusBadgeClass(evt.Status)">
                                @Model.GetStatusName(evt.Status)
                            </span>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="text-muted text-center py-3 mb-0">
                <i class="bi bi-calendar-x display-6 d-block mb-2"></i>
                @L["CalendarPage.NoUpcomingEvents"]
            </p>
        }
    </div>
</div>

<!-- Legend -->
<div class="spec-card mt-3">
    <div class="spec-card-header">
        <h5 class="mb-0"><i class="bi bi-palette me-2"></i>@L["CalendarPage.Legend"]</h5>
    </div>
    <div class="spec-card-body">
        <div class="d-flex align-items-center mb-2">
            <span class="badge me-2" style="background-color: #0d6efd;">&nbsp;&nbsp;</span>
            <small>@L["CalendarPage.TypeParentTeacher"]</small>
        </div>
        <div class="d-flex align-items-center mb-2">
            <span class="badge me-2" style="background-color: #198754;">&nbsp;&nbsp;</span>
            <small>@L["CalendarPage.TypeIndividual"]</small>
        </div>
        <div class="d-flex align-items-center mb-2">
            <span class="badge me-2" style="background-color: #dc3545;">&nbsp;&nbsp;</span>
            <small>@L["CalendarPage.TypePlppIvpReview"]</small>
        </div>
        <div class="d-flex align-items-center mb-2">
            <span class="badge me-2" style="background-color: #6f42c1;">&nbsp;&nbsp;</span>
            <small>@L["CalendarPage.TypeCounselor"]</small>
        </div>
        <div class="d-flex align-items-center mb-2">
            <span class="badge me-2" style="background-color: #20c997;">&nbsp;&nbsp;</span>
            <small>@L["CalendarPage.TypeSchoolEvent"]</small>
        </div>
    </div>
</div>
