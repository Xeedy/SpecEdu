@page "{id:guid}"
@model SpecEdu.Web.App.Pages.SchoolAdmin.Students.DiaryModel
@inject IStringLocalizer<SpecEdu.Web.App.SharedResource> L
@{
    ViewData["Title"] = $"Deník - {Model.Student.FullName}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1><i class="bi bi-journal-text me-2"></i>@L["DiaryPage.Title"]</h1>
            <p class="text-muted mb-0">@Model.Student.FullName</p>
        </div>
        <div>
            <a asp-page="DiaryCreate" asp-route-studentId="@Model.Id" class="btn btn-spec-primary">
                <i class="bi bi-plus-lg me-2"></i>@L["DiaryPage.AddEntry"]
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics -->
    <div class="row g-3 mb-4">
        <div class="col-md-2 col-6">
            <div class="spec-card p-3 text-center">
                <div class="fs-4 fw-bold text-primary">@Model.Entries.Count</div>
                <small class="text-muted">@L["DiaryPage.TotalEntries"]</small>
            </div>
        </div>
        @foreach (var count in Model.EntryCounts)
        {
            <div class="col-md-2 col-6">
                <div class="spec-card p-3 text-center">
                    <div class="fs-4 fw-bold text-@Model.GetEntryTypeColor(count.Key)">@count.Value</div>
                    <small class="text-muted">@Model.GetEntryTypeName(count.Key)</small>
                </div>
            </div>
        }
    </div>

    <!-- Filters -->
    <div class="spec-card mb-4">
        <div class="spec-card-body">
            <form method="get" class="row g-3 align-items-end">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="col-md-3">
                    <label class="form-label">@L["DiaryPage.FilterType"]</label>
                    <select class="form-select" name="FilterType" asp-items="Model.EntryTypeOptions">
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["DiaryPage.FilterFromDate"]</label>
                    <input type="date" class="form-control" name="FilterFromDate" value="@Model.FilterFromDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["DiaryPage.FilterToDate"]</label>
                    <input type="date" class="form-control" name="FilterToDate" value="@Model.FilterToDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-spec-primary w-100">
                        <i class="bi bi-funnel me-2"></i>@L["Common.Filter"]
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Timeline -->
    <div class="spec-card">
        <div class="spec-card-body">
            @if (Model.Entries.Any())
            {
                <div class="timeline">
                    @foreach (var entry in Model.Entries)
                    {
                        <div class="timeline-item mb-4 pb-4 border-bottom">
                            <div class="d-flex">
                                <div class="timeline-icon me-3">
                                    <div class="rounded-circle bg-@Model.GetEntryTypeColor(entry.Type) d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <i class="bi @Model.GetEntryTypeIcon(entry.Type) text-white"></i>
                                    </div>
                                </div>
                                <div class="timeline-content flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="mb-1">@entry.Title</h5>
                                            <div class="text-muted small">
                                                <span class="badge bg-@Model.GetEntryTypeColor(entry.Type) me-2">@Model.GetEntryTypeName(entry.Type)</span>
                                                @Html.Raw(Model.GetVisibilityBadge(entry.Visibility))
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <div class="text-muted small">
                                                @entry.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                            </div>
                                            @if (entry.OccurredAt.HasValue && entry.OccurredAt != entry.CreatedAt)
                                            {
                                                <div class="text-muted small">
                                                    <i class="bi bi-calendar-event me-1"></i>@entry.OccurredAt.Value.ToString("dd.MM.yyyy")
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <p class="mb-2">@entry.Content</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="bi bi-person me-1"></i>@(entry.CreatedByName ?? "Neznámý")
                                            @if (entry.AttachmentCount > 0)
                                            {
                                                <span class="ms-2">
                                                    <i class="bi bi-paperclip me-1"></i>@entry.AttachmentCount @L["DiaryPage.Attachments"]
                                                </span>
                                            }
                                        </small>
                                        <div>
                                            <a asp-page="DiaryEdit" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" asp-page-handler="Delete" asp-route-entryId="@entry.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('@L["DiaryPage.ConfirmDelete"]')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-4">
                        <ul class="pagination justify-content-center mb-0">
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-page="Diary"
                                       asp-route-id="@Model.Id"
                                       asp-route-currentpage="@i"
                                       asp-route-filtertype="@Model.FilterType"
                                       asp-route-filterfromdate="@Model.FilterFromDate?.ToString("yyyy-MM-dd")"
                                       asp-route-filtertodate="@Model.FilterToDate?.ToString("yyyy-MM-dd")">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-journal-x display-1 text-muted"></i>
                    <p class="text-muted mt-3 mb-3">@L["DiaryPage.NoEntries"]</p>
                    <a asp-page="DiaryCreate" asp-route-studentId="@Model.Id" class="btn btn-spec-primary">
                        <i class="bi bi-plus-lg me-2"></i>@L["DiaryPage.AddFirstEntry"]
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>@L["Common.BackToDetails"]
        </a>
    </div>
</div>

<style>
    .timeline-item:last-child {
        border-bottom: none !important;
        margin-bottom: 0 !important;
        padding-bottom: 0 !important;
    }
</style>
