<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpecEdu.Web.App</RootNamespace>
    <UserSecretsId>99b84057-1eb0-4ee1-8e19-51943fd68937</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpecEdu.Application\SpecEdu.Application.csproj" />
