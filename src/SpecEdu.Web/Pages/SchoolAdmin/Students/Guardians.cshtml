@page "{id:guid}"
@model SpecEdu.Web.Pages.SchoolAdmin.Students.GuardiansModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = $"{L["StudentsPage.Guardians"]} - {Model.Student.FullName}";
}

<div class="container py-4">
    <h1 class="mb-4">@L["StudentsPage.Guardians"] - @Model.Student.FullName</h1>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
        </div>
    }

    <!-- Add Guardian Form -->
    <div class="spec-card mb-4">
        <div class="spec-card-header">
            <h5 class="mb-0">@L["StudentsPage.AddGuardian"]</h5>
        </div>
        <div class="spec-card-body">
            <form method="post" asp-page-handler="Add" asp-route-id="@Model.Student.Id">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-5">
                        <label asp-for="AddInput.ParentUserId" class="form-label">@L["StudentsPage.Parent"]</label>
                        <select asp-for="AddInput.ParentUserId" asp-items="Model.AvailableParents" class="form-select">
                            <option value="">@L["Common.Select"]...</option>
                        </select>
                        <span asp-validation-for="AddInput.ParentUserId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AddInput.RelationshipType" class="form-label">@L["StudentsPage.RelationshipType"]</label>
                        <select asp-for="AddInput.RelationshipType" asp-items="Model.RelationshipTypes" class="form-select">
                        </select>
                        <span asp-validation-for="AddInput.RelationshipType" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label d-block">&nbsp;</label>
                        <button type="submit" class="btn btn-spec-primary w-100">@L["Common.Add"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Current Guardians -->
    <div class="spec-card">
        <div class="spec-card-header">
            <h5 class="mb-0">@L["StudentsPage.CurrentGuardians"]</h5>
        </div>
        <div class="spec-card-body">
            @if (Model.Guardians.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>@L["StudentsPage.Parent"]</th>
                                <th>@L["StudentsPage.Email"]</th>
                                <th>@L["StudentsPage.RelationshipType"]</th>
                                <th>@L["StudentsPage.Status"]</th>
                                <th class="text-end">@L["Common.Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var guardian in Model.Guardians)
                            {
                                <tr>
                                    <td><strong>@(guardian.ParentName ?? "-")</strong></td>
                                    <td>@(guardian.ParentEmail ?? "-")</td>
                                    <td>@guardian.RelationshipTypeName</td>
                                    <td>
                                        @if (guardian.IsActive)
                                        {
                                            <span class="badge bg-success">@L["Common.Active"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@L["Common.Inactive"]</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="Remove" asp-route-id="@Model.Student.Id" asp-route-guardianId="@guardian.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('@L["Common.ConfirmRemove"]')">
                                                @L["Common.Remove"]
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">@L["StudentsPage.NoGuardians"]</p>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="Details" asp-route-id="@Model.Student.Id" class="btn btn-outline-secondary">@L["Common.Back"]</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
