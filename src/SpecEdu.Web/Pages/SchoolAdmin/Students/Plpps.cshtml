@page "{id:guid}"
@model SpecEdu.Web.Pages.SchoolAdmin.Students.PlppsModel
@using SpecEdu.Web.Pages.SchoolAdmin.Students
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = $"PLPP - {Model.Student.FullName}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1><i class="bi bi-file-earmark-text me-2"></i>Plany pedagogicke podpory</h1>
            <p class="text-muted mb-0">@Model.Student.FullName</p>
        </div>
        <div>
            <a asp-page="PlppCreate" asp-route-studentId="@Model.Id" class="btn btn-spec-primary">
                <i class="bi bi-plus-lg me-2"></i>Novy PLPP
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="spec-card p-3 text-center">
                <div class="fs-4 fw-bold text-primary">@Model.Plpps.Count</div>
                <small class="text-muted">Celkem PLPP</small>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="spec-card p-3 text-center">
                <div class="fs-4 fw-bold text-success">@Model.Plpps.Count(p => p.Status == SpecEdu.Domain.Enums.PlppStatus.Active)</div>
                <small class="text-muted">Aktivni</small>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="spec-card p-3 text-center">
                <div class="fs-4 fw-bold text-secondary">@Model.Plpps.Count(p => p.Status == SpecEdu.Domain.Enums.PlppStatus.Draft)</div>
                <small class="text-muted">Koncepty</small>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="spec-card p-3 text-center">
                <div class="fs-4 fw-bold text-dark">@Model.Plpps.Count(p => p.Status == SpecEdu.Domain.Enums.PlppStatus.Archived)</div>
                <small class="text-muted">Archivovano</small>
            </div>
        </div>
    </div>

    <!-- PLPP List -->
    <div class="spec-card">
        <div class="spec-card-body">
            @if (Model.Plpps.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Skolni rok</th>
                                <th>Stupen podpory</th>
                                <th>Stav</th>
                                <th>Platnost</th>
                                <th class="text-center">Cile</th>
                                <th class="text-center">Hodnoceni</th>
                                <th class="text-end">Akce</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var plpp in Model.Plpps)
                            {
                                <tr>
                                    <td>
                                        <strong>@plpp.SchoolYear</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@PlppsModel.GetSupportLevelName(plpp.SupportLevel)</span>
                                    </td>
                                    <td>
                                        <span class="badge @PlppsModel.GetStatusBadgeClass(plpp.Status)">
                                            @PlppsModel.GetStatusName(plpp.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <small>@plpp.ValidFrom.ToString("dd.MM.yyyy") - @plpp.ValidTo.ToString("dd.MM.yyyy")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary rounded-pill">@plpp.GoalCount</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary rounded-pill">@plpp.EvaluationCount</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-page="PlppDownload" asp-route-id="@plpp.Id" class="btn btn-outline-secondary" title="Stahnout PDF">
                                                <i class="bi bi-file-pdf"></i>
                                            </a>
                                            <a asp-page="PlppEdit" asp-route-id="@plpp.Id" class="btn btn-outline-primary" title="Upravit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (plpp.Status == SpecEdu.Domain.Enums.PlppStatus.Draft)
                                            {
                                                <form method="post" asp-page-handler="Activate" asp-route-plppId="@plpp.Id" class="d-inline">
                                                    <button type="submit" class="btn btn-outline-success" title="Aktivovat" onclick="return confirm('Opravdu chcete aktivovat tento PLPP?')">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (plpp.Status != SpecEdu.Domain.Enums.PlppStatus.Archived)
                                            {
                                                <form method="post" asp-page-handler="Archive" asp-route-plppId="@plpp.Id" class="d-inline">
                                                    <button type="submit" class="btn btn-outline-secondary" title="Archivovat" onclick="return confirm('Opravdu chcete archivovat tento PLPP?')">
                                                        <i class="bi bi-archive"></i>
                                                    </button>
                                                </form>
                                            }
                                            <form method="post" asp-page-handler="Delete" asp-route-plppId="@plpp.Id" class="d-inline">
                                                <button type="submit" class="btn btn-outline-danger" title="Smazat" onclick="return confirm('Opravdu chcete smazat tento PLPP? Tato akce je nevratna.')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-file-earmark-x display-1 text-muted"></i>
                    <p class="text-muted mt-3 mb-3">Zadny plan pedagogicke podpory.</p>
                    <a asp-page="PlppCreate" asp-route-studentId="@Model.Id" class="btn btn-spec-primary">
                        <i class="bi bi-plus-lg me-2"></i>Vytvorit prvni PLPP
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>@L["Common.BackToDetails"]
        </a>
    </div>
</div>
