@page "{id:guid}"
@model SpecEdu.Web.Pages.SchoolAdmin.Calendar.DetailsModel
@using SpecEdu.Web.Pages.SchoolAdmin.Calendar
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = Model.Event.Title;
    var isPast = Model.Event.EndTime < DateTime.UtcNow;
    var isCancelled = Model.Event.Status == SpecEdu.Domain.Enums.ConsultationEventStatus.Cancelled;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1><i class="bi bi-calendar-event me-2"></i>@Model.Event.Title</h1>
            <p class="text-muted mb-0">
                <span class="badge @DetailsModel.GetStatusBadgeClass(Model.Event.Status) me-2">
                    @DetailsModel.GetStatusName(Model.Event.Status)
                </span>
                @DetailsModel.GetTypeName(Model.Event.Type)
            </p>
        </div>
        <div>
            <a asp-page="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>Zpet na kalendar
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <!-- Event Details -->
            <div class="spec-card mb-4">
                <div class="spec-card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Detaily konzultace</h5>
                </div>
                <div class="spec-card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong><i class="bi bi-calendar me-2"></i>Datum a cas:</strong>
                            <p class="mb-0">
                                @Model.Event.StartTime.ToString("dddd d. MMMM yyyy", new global::System.Globalization.CultureInfo("cs-CZ"))<br />
                                @Model.Event.StartTime.ToString("HH:mm") - @Model.Event.EndTime.ToString("HH:mm")
                            </p>
                        </div>
                        <div class="col-md-6">
                            <strong><i class="bi bi-geo-alt me-2"></i>Misto:</strong>
                            <p class="mb-0">@(Model.Event.Location ?? "Neuvedeno")</p>
                            @if (!string.IsNullOrEmpty(Model.Event.OnlineMeetingLink))
                            {
                                <a href="@Model.Event.OnlineMeetingLink" target="_blank" class="btn btn-sm btn-outline-primary mt-1">
                                    <i class="bi bi-camera-video me-1"></i>Pripojit se online
                                </a>
                            }
                        </div>
                    </div>

                    @if (Model.Event.StudentId.HasValue)
                    {
                        <div class="mb-3">
                            <strong><i class="bi bi-person me-2"></i>Zak:</strong>
                            <p class="mb-0">
                                <a asp-page="/SchoolAdmin/Students/Details" asp-route-id="@Model.Event.StudentId">
                                    @Model.Event.StudentName
                                </a>
                            </p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Event.Description))
                    {
                        <div class="mb-3">
                            <strong><i class="bi bi-text-paragraph me-2"></i>Popis / program:</strong>
                            <p class="mb-0">@Model.Event.Description</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Event.Notes))
                    {
                        <div class="mb-3">
                            <strong><i class="bi bi-sticky me-2"></i>Poznamky z prubehu:</strong>
                            <p class="mb-0">@Model.Event.Notes</p>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6">
                            <strong><i class="bi bi-person-badge me-2"></i>Organizator:</strong>
                            <p class="mb-0">@(Model.Event.OrganizerName ?? "Neuveden")</p>
                        </div>
                        <div class="col-md-6">
                            <strong><i class="bi bi-eye me-2"></i>Viditelnost:</strong>
                            <p class="mb-0">
                                @if (Model.Event.IsVisibleToParents)
                                {
                                    <span class="badge bg-success">Viditelne pro rodice</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pouze pro personal</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Participants -->
            <div class="spec-card mb-4">
                <div class="spec-card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-people me-2"></i>Ucastnici (@Model.Event.Participants.Count)
                    </h5>
                    @if (!isCancelled && Model.Event.StudentId.HasValue)
                    {
                        <div class="btn-group btn-group-sm">
                            <form method="post" asp-page-handler="InviteGuardians" class="d-inline">
                                <button type="submit" class="btn btn-outline-primary">
                                    <i class="bi bi-person-plus me-1"></i>Pozvat rodice
                                </button>
                            </form>
                            <form method="post" asp-page-handler="InviteStaff" class="d-inline ms-1">
                                <button type="submit" class="btn btn-outline-secondary">
                                    <i class="bi bi-person-plus me-1"></i>Pozvat ucitele
                                </button>
                            </form>
                        </div>
                    }
                </div>
                <div class="spec-card-body">
                    @if (Model.Event.Participants.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Jmeno</th>
                                        <th>Role</th>
                                        <th>Stav</th>
                                        <th class="text-end">Akce</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var participant in Model.Event.Participants.OrderByDescending(p => p.IsOrganizer))
                                    {
                                        <tr>
                                            <td>
                                                @participant.DisplayName
                                                @if (participant.IsOrganizer)
                                                {
                                                    <span class="badge bg-primary ms-1">Organizator</span>
                                                }
                                                @if (participant.IsExternal)
                                                {
                                                    <span class="badge bg-info ms-1">Externi</span>
                                                }
                                            </td>
                                            <td>@(participant.RoleDescription ?? "-")</td>
                                            <td>
                                                <span class="badge @DetailsModel.GetResponseStatusBadgeClass(participant.ResponseStatus)">
                                                    @DetailsModel.GetResponseStatusName(participant.ResponseStatus)
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                @if (!participant.IsOrganizer && !isCancelled)
                                                {
                                                    <form method="post" asp-page-handler="RemoveParticipant" asp-route-participantId="@participant.Id" class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Opravdu chcete odebrat tohoto ucastnika?')">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <small class="text-muted">
                                <span class="badge bg-success me-1">@Model.Event.AcceptedCount</span> prijalo
                                <span class="badge bg-danger mx-1">@Model.Event.DeclinedCount</span> odmitnulo
                                <span class="badge bg-secondary mx-1">@Model.Event.PendingCount</span> ceka na odpoved
                            </small>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3 mb-0">Zatim zadni ucastnici.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Actions -->
            <div class="spec-card mb-4">
                <div class="spec-card-header">
                    <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Akce</h5>
                </div>
                <div class="spec-card-body d-grid gap-2">
                    @if (!isCancelled && !isPast)
                    {
                        <a asp-page="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                            <i class="bi bi-pencil me-2"></i>Upravit
                        </a>

                        @if (Model.Event.Status == SpecEdu.Domain.Enums.ConsultationEventStatus.Scheduled)
                        {
                            <form method="post" asp-page-handler="Confirm">
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-check-lg me-2"></i>Potvrdit konzultaci
                                </button>
                            </form>
                        }

                        <form method="post" asp-page-handler="Cancel">
                            <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Opravdu chcete zrusit tuto konzultaci?')">
                                <i class="bi bi-x-lg me-2"></i>Zrusit konzultaci
                            </button>
                        </form>
                    }

                    @if (!isCancelled && isPast && Model.Event.Status != SpecEdu.Domain.Enums.ConsultationEventStatus.Completed)
                    {
                        <form method="post" asp-page-handler="Complete">
                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-check-circle me-2"></i>Oznacit jako probehle
                            </button>
                        </form>
                    }

                    <hr />

                    <form method="post" asp-page-handler="Delete">
                        <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Opravdu chcete smazat tuto konzultaci? Tato akce je nevratna.')">
                            <i class="bi bi-trash me-2"></i>Smazat
                        </button>
                    </form>
                </div>
            </div>

            <!-- Info -->
            <div class="spec-card">
                <div class="spec-card-header">
                    <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Informace</h5>
                </div>
                <div class="spec-card-body">
                    <p class="mb-1">
                        <small class="text-muted">Vytvoreno: @Model.Event.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                    </p>
                    @if (Model.Event.ModifiedAt.HasValue)
                    {
                        <p class="mb-1">
                            <small class="text-muted">Upraveno: @Model.Event.ModifiedAt.Value.ToString("dd.MM.yyyy HH:mm")</small>
                        </p>
                    }
                    @if (Model.Event.ReminderMinutesBefore.HasValue)
                    {
                        <p class="mb-0">
                            <small class="text-muted">
                                Pripominka: @(Model.Event.ReminderSent ? "Odeslana" : $"{Model.Event.ReminderMinutesBefore / 60} hodin pred")
                            </small>
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
