@page "{id:guid}"
@model SpecEdu.Web.Pages.SchoolAdmin.Calendar.DetailsModel
@using SpecEdu.Web.Pages.SchoolAdmin.Calendar
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = Model.Event.Title;
    var isPast = Model.Event.EndTime < DateTime.UtcNow;
    var isCancelled = Model.Event.Status == SpecEdu.Domain.Enums.ConsultationEventStatus.Cancelled;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1><i class="bi bi-calendar-event me-2"></i>@Model.Event.Title</h1>
            <p class="text-muted mb-0">
                <span class="badge @DetailsModel.GetStatusBadgeClass(Model.Event.Status) me-2">
                    @Model.GetStatusName(Model.Event.Status)
                </span>
                @Model.GetTypeName(Model.Event.Type)
            </p>
        </div>
        <div>
            <a asp-page="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>@L["CalendarPage.BackToCalendar"]
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <!-- Event Details -->
            <div class="spec-card mb-4">
                <div class="spec-card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>@L["CalendarPage.EventDetails"]</h5>
                </div>
                <div class="spec-card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong><i class="bi bi-calendar me-2"></i>@L["CalendarPage.DateTimeLabel"]</strong>
                            <p class="mb-0">
                                @Model.Event.StartTime.ToString("dddd d. MMMM yyyy", new global::System.Globalization.CultureInfo("cs-CZ"))<br />
                                @Model.Event.StartTime.ToString("HH:mm") - @Model.Event.EndTime.ToString("HH:mm")
                            </p>
                        </div>
                        <div class="col-md-6">
                            <strong><i class="bi bi-geo-alt me-2"></i>@L["CalendarPage.LocationLabel"]</strong>
                            <p class="mb-0">@(Model.Event.Location ?? L["CalendarPage.NotSpecified"].Value)</p>
                            @if (!string.IsNullOrEmpty(Model.Event.OnlineMeetingLink))
                            {
                                <a href="@Model.Event.OnlineMeetingLink" target="_blank" class="btn btn-sm btn-outline-primary mt-1">
                                    <i class="bi bi-camera-video me-1"></i>@L["CalendarPage.JoinOnline"]
                                </a>
                            }
                        </div>
                    </div>

                    @if (Model.Event.StudentId.HasValue)
                    {
                        <div class="mb-3">
                            <strong><i class="bi bi-person me-2"></i>@L["CalendarPage.StudentLabel"]</strong>
                            <p class="mb-0">
                                <a asp-page="/SchoolAdmin/Students/Details" asp-route-id="@Model.Event.StudentId">
                                    @Model.Event.StudentName
                                </a>
                            </p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Event.Description))
                    {
                        <div class="mb-3">
                            <strong><i class="bi bi-text-paragraph me-2"></i>@L["CalendarPage.DescriptionLabel"]</strong>
                            <p class="mb-0">@Model.Event.Description</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Event.Notes))
                    {
                        <div class="mb-3">
                            <strong><i class="bi bi-sticky me-2"></i>@L["CalendarPage.NotesLabel"]</strong>
                            <p class="mb-0">@Model.Event.Notes</p>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6">
                            <strong><i class="bi bi-person-badge me-2"></i>@L["CalendarPage.OrganizerLabel"]</strong>
                            <p class="mb-0">@(Model.Event.OrganizerName ?? L["CalendarPage.NotSpecified"].Value)</p>
                        </div>
                        <div class="col-md-6">
                            <strong><i class="bi bi-eye me-2"></i>@L["CalendarPage.VisibilityLabel"]</strong>
                            <p class="mb-0">
                                @if (Model.Event.IsVisibleToParents)
                                {
                                    <span class="badge bg-success">@L["CalendarPage.VisibleToParents"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@L["CalendarPage.StaffOnly"]</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Participants -->
            <div class="spec-card mb-4">
                <div class="spec-card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-people me-2"></i>@L["CalendarPage.Participants"] (@Model.Event.Participants.Count)
                    </h5>
                    @if (!isCancelled && Model.Event.StudentId.HasValue)
                    {
                        <div class="btn-group btn-group-sm">
                            <form method="post" asp-page-handler="InviteGuardians" class="d-inline">
                                <button type="submit" class="btn btn-outline-primary">
                                    <i class="bi bi-person-plus me-1"></i>@L["CalendarPage.InviteParents"]
                                </button>
                            </form>
                            <form method="post" asp-page-handler="InviteStaff" class="d-inline ms-1">
                                <button type="submit" class="btn btn-outline-secondary">
                                    <i class="bi bi-person-plus me-1"></i>@L["CalendarPage.InviteTeachers"]
                                </button>
                            </form>
                        </div>
                    }
                </div>
                <div class="spec-card-body">
                    @if (Model.Event.Participants.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>@L["CalendarPage.ParticipantName"]</th>
                                        <th>@L["CalendarPage.ParticipantRole"]</th>
                                        <th>@L["CalendarPage.ParticipantStatus"]</th>
                                        <th class="text-end">@L["CalendarPage.ParticipantActions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var participant in Model.Event.Participants.OrderByDescending(p => p.IsOrganizer))
                                    {
                                        <tr>
                                            <td>
                                                @participant.DisplayName
                                                @if (participant.IsOrganizer)
                                                {
                                                    <span class="badge bg-primary ms-1">@L["CalendarPage.Organizer"]</span>
                                                }
                                                @if (participant.IsExternal)
                                                {
                                                    <span class="badge bg-info ms-1">@L["CalendarPage.External"]</span>
                                                }
                                            </td>
                                            <td>@(participant.RoleDescription ?? "-")</td>
                                            <td>
                                                <span class="badge @DetailsModel.GetResponseStatusBadgeClass(participant.ResponseStatus)">
                                                    @Model.GetResponseStatusName(participant.ResponseStatus)
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                @if (!participant.IsOrganizer && !isCancelled)
                                                {
                                                    <form method="post" asp-page-handler="RemoveParticipant" asp-route-participantId="@participant.Id" class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('@L["CalendarPage.ConfirmRemoveParticipant"]')">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <small class="text-muted">
                                <span class="badge bg-success me-1">@Model.Event.AcceptedCount</span> @L["CalendarPage.Accepted"]
                                <span class="badge bg-danger mx-1">@Model.Event.DeclinedCount</span> @L["CalendarPage.Declined"]
                                <span class="badge bg-secondary mx-1">@Model.Event.PendingCount</span> @L["CalendarPage.PendingResponse"]
                            </small>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3 mb-0">@L["CalendarPage.NoParticipants"]</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Actions -->
            <div class="spec-card mb-4">
                <div class="spec-card-header">
                    <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>@L["CalendarPage.Actions"]</h5>
                </div>
                <div class="spec-card-body d-grid gap-2">
                    @if (!isCancelled && !isPast)
                    {
                        <a asp-page="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                            <i class="bi bi-pencil me-2"></i>@L["CalendarPage.Edit"]
                        </a>

                        @if (Model.Event.Status == SpecEdu.Domain.Enums.ConsultationEventStatus.Scheduled)
                        {
                            <form method="post" asp-page-handler="Confirm">
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-check-lg me-2"></i>@L["CalendarPage.ConfirmEvent"]
                                </button>
                            </form>
                        }

                        <form method="post" asp-page-handler="SendNotifications">
                            <button type="submit" class="btn btn-outline-info w-100">
                                <i class="bi bi-bell me-2"></i>@L["CalendarPage.SendNotifications"]
                            </button>
                        </form>

                        <form method="post" asp-page-handler="Cancel">
                            <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('@L["CalendarPage.ConfirmCancelEvent"]')">
                                <i class="bi bi-x-lg me-2"></i>@L["CalendarPage.CancelEvent"]
                            </button>
                        </form>
                    }

                    @if (!isCancelled && isPast && Model.Event.Status != SpecEdu.Domain.Enums.ConsultationEventStatus.Completed)
                    {
                        <form method="post" asp-page-handler="Complete">
                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-check-circle me-2"></i>@L["CalendarPage.MarkCompleted"]
                            </button>
                        </form>
                    }

                    <hr />

                    <form method="post" asp-page-handler="Delete">
                        <button type="submit" class="btn btn-danger w-100" onclick="return confirm('@L["CalendarPage.ConfirmDelete"]')">
                            <i class="bi bi-trash me-2"></i>@L["CalendarPage.Delete"]
                        </button>
                    </form>
                </div>
            </div>

            <!-- Info -->
            <div class="spec-card">
                <div class="spec-card-header">
                    <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>@L["CalendarPage.Info"]</h5>
                </div>
                <div class="spec-card-body">
                    <p class="mb-1">
                        <small class="text-muted">@L["CalendarPage.CreatedAt"] @Model.Event.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                    </p>
                    @if (Model.Event.ModifiedAt.HasValue)
                    {
                        <p class="mb-1">
                            <small class="text-muted">@L["CalendarPage.ModifiedAt"] @Model.Event.ModifiedAt.Value.ToString("dd.MM.yyyy HH:mm")</small>
                        </p>
                    }
                    @if (Model.Event.ReminderMinutesBefore.HasValue)
                    {
                        <p class="mb-0">
                            <small class="text-muted">
                                @L["CalendarPage.Reminder"] @(Model.Event.ReminderSent ? L["CalendarPage.ReminderSent"].Value : $"{Model.Event.ReminderMinutesBefore / 60} hodin pred")
                            </small>
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
