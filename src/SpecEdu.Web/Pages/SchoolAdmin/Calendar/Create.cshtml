@page
@model SpecEdu.Web.Pages.SchoolAdmin.Calendar.CreateModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = "Nova konzultace";
}

<div class="container py-4">
    <div class="mb-4">
        <h1><i class="bi bi-calendar-plus me-2"></i>Nova konzultace</h1>
        <p class="text-muted mb-0">Vytvorte novou konzultaci nebo schuzku</p>
    </div>

    <form method="post">
        <div class="row">
            <div class="col-lg-8">
                <!-- Basic Info -->
                <div class="spec-card mb-4">
                    <div class="spec-card-header">
                        <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Zakladni udaje</h5>
                    </div>
                    <div class="spec-card-body">
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label asp-for="Input.Title" class="form-label"></label>
                                <input asp-for="Input.Title" class="form-control" placeholder="napr. Konzultace ohledne vyuky" />
                                <span asp-validation-for="Input.Title" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.Type" class="form-label"></label>
                                <select asp-for="Input.Type" class="form-select" asp-items="Model.TypeOptions"></select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Description" class="form-label"></label>
                            <textarea asp-for="Input.Description" class="form-control" rows="3" placeholder="Program schuzky, poznamky..."></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.StudentId" class="form-label"></label>
                            <select asp-for="Input.StudentId" class="form-select" asp-items="Model.StudentOptions">
                            </select>
                            <small class="text-muted">Volitelne - vyberte zaka, pokud se konzultace tyka konkretniho zaka.</small>
                        </div>
                    </div>
                </div>

                <!-- Date & Time -->
                <div class="spec-card mb-4">
                    <div class="spec-card-header">
                        <h5 class="mb-0"><i class="bi bi-clock me-2"></i>Datum a cas</h5>
                    </div>
                    <div class="spec-card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.StartTime" class="form-label"></label>
                                <input asp-for="Input.StartTime" type="datetime-local" class="form-control" />
                                <span asp-validation-for="Input.StartTime" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.EndTime" class="form-label"></label>
                                <input asp-for="Input.EndTime" type="datetime-local" class="form-control" />
                                <span asp-validation-for="Input.EndTime" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Location -->
                <div class="spec-card mb-4">
                    <div class="spec-card-header">
                        <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Misto konani</h5>
                    </div>
                    <div class="spec-card-body">
                        <div class="mb-3">
                            <label asp-for="Input.Location" class="form-label"></label>
                            <input asp-for="Input.Location" class="form-control" placeholder="napr. Ucebna 205, Sborovna..." />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.OnlineMeetingLink" class="form-label"></label>
                            <input asp-for="Input.OnlineMeetingLink" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="Input.OnlineMeetingLink" class="text-danger"></span>
                            <small class="text-muted">Volitelne - odkaz na online schuzku (Teams, Zoom, apod.)</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Settings -->
                <div class="spec-card mb-4">
                    <div class="spec-card-header">
                        <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Nastaveni</h5>
                    </div>
                    <div class="spec-card-body">
                        <div class="form-check mb-3">
                            <input asp-for="Input.IsVisibleToParents" class="form-check-input" type="checkbox" />
                            <label asp-for="Input.IsVisibleToParents" class="form-check-label"></label>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Input.AllowResponses" class="form-check-input" type="checkbox" />
                            <label asp-for="Input.AllowResponses" class="form-check-label"></label>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ReminderMinutesBefore" class="form-label"></label>
                            <select asp-for="Input.ReminderMinutesBefore" class="form-select">
                                <option value="">Bez pripominek</option>
                                <option value="60">1 hodina pred</option>
                                <option value="120">2 hodiny pred</option>
                                <option value="1440">1 den pred</option>
                                <option value="2880">2 dny pred</option>
                                <option value="10080">1 tyden pred</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Auto-invite -->
                <div class="spec-card mb-4" id="inviteOptions" style="display: none;">
                    <div class="spec-card-header">
                        <h5 class="mb-0"><i class="bi bi-people me-2"></i>Automaticke pozvanky</h5>
                    </div>
                    <div class="spec-card-body">
                        <div class="form-check mb-3">
                            <input asp-for="Input.InviteGuardians" class="form-check-input" type="checkbox" />
                            <label asp-for="Input.InviteGuardians" class="form-check-label"></label>
                            <small class="d-block text-muted">Automaticky pozve zakonné zastupce vybraneho zaka.</small>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Input.InviteStaff" class="form-check-input" type="checkbox" />
                            <label asp-for="Input.InviteStaff" class="form-check-label"></label>
                            <small class="d-block text-muted">Automaticky pozve ucitele prirazene k zakovi.</small>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-spec-primary">
                        <i class="bi bi-check-lg me-2"></i>Vytvorit konzultaci
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-2"></i>Zrusit
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var studentSelect = document.getElementById('Input_StudentId');
            var inviteOptions = document.getElementById('inviteOptions');

            function toggleInviteOptions() {
                if (studentSelect.value) {
                    inviteOptions.style.display = 'block';
                } else {
                    inviteOptions.style.display = 'none';
                }
            }

            studentSelect.addEventListener('change', toggleInviteOptions);
            toggleInviteOptions();
        });
    </script>
}
