@page
@model TestModel
@{
    ViewData["Title"] = "Test";
}

<h1>@L["TestPage.Title"]</h1>
<p class="text-muted">@L["TestPage.TitleDescription"]</p>

<hr />

<h2>@L["TestPage.ButtonsTitle"]</h2>
<div class="mb-4">
    <button class="btn btn-spec-primary me-2">@L["TestPage.PrimaryButton"]</button>
    <button class="btn btn-spec-outline me-2">@L["TestPage.OutlineButton"]</button>
    <button class="btn btn-secondary me-2">@L["TestPage.SecondaryButton"]</button>
    <button class="btn btn-success me-2">@L["TestPage.SuccessButton"]</button>
    <button class="btn btn-danger">@L["TestPage.WarningButton"]</button>
</div>

<hr />

<h2>@L["TestPage.CardsTitle"]</h2>
<div class="row mb-4">
    <div class="col-md-4">
        <div class="spec-card">
            <div class="spec-card-header">@L["TestPage.CardOne"]</div>
            <div class="spec-card-body">
                <p>@L["TestPage.CardText"]</p>
                <button class="btn btn-spec-primary btn-sm">@L["TestPage.CardActionButton"]</button>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="spec-card">
            <div class="spec-card-header">@L["TestPage.CardTwo"]</div>
            <div class="spec-card-body">
                <p>@L["TestPage.CardText"]</p>
                <button class="btn btn-spec-outline btn-sm">@L["TestPage.CardActionButton"]</button>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="spec-card">
            <div class="spec-card-header">@L["TestPage.CardThree"]</div>
            <div class="spec-card-body">
                <p>@L["TestPage.CardText"]</p>
                <button class="btn btn-secondary btn-sm">@L["TestPage.CardActionButton"]</button>
            </div>
        </div>
    </div>
</div>

<hr />

<h2>Formular</h2>
<div class="row mb-4">
    <div class="col-md-6">
        <div class="spec-card">
            <div class="spec-card-header">Prihlaseni</div>
            <div class="spec-card-body">
                <form>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" placeholder="vas@email.cz">
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Heslo</label>
                        <input type="password" class="form-control" id="password" placeholder="Vase heslo">
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="remember">
                        <label class="form-check-label" for="remember">Zapamatovat si me</label>
                    </div>
                    <button type="submit" class="btn btn-spec-primary">Prihlasit se</button>
                </form>
            </div>
        </div>
    </div>
</div>

<hr />

<h2>Barvy</h2>
<h2>@L["TestPage.ColorsTitle"]</h2>
<div class="row mb-4">
    <div class="col-md-12">
        <div class="d-flex flex-wrap gap-3">
            <div class="p-3 bg-spec-primary text-white rounded">Primary</div>
            <div class="p-3 bg-spec-primary-light rounded">Primary Light</div>
            <div class="p-3 bg-success text-white rounded">Success</div>
            <div class="p-3 bg-warning rounded">Warning</div>
            <div class="p-3 bg-danger text-white rounded">Danger</div>
            <div class="p-3 bg-secondary text-white rounded">Secondary</div>
        </div>
    </div>
</div>

<hr />

<h2>Typografie</h2>
<div class="mb-4">
    <h1>Nadpis H1</h1>
    <h2>Nadpis H2</h2>
    <h3>Nadpis H3</h3>
    <h4>Nadpis H4</h4>
    <p>Bezny odstavec textu. Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
    <p class="text-spec-primary">Text v primarni barve</p>
    <p class="text-muted">Utlumeny text</p>
</div>

<hr />

<h2>Navigace</h2>
<p>Otestujte navigaci mezi strankami pro overeni, ze nedochazi k posunu layoutu:</p>
<ul>
    <li><a asp-page="/Index">Domov</a></li>
    <li><a asp-page="/Privacy">Ochrana soukromi</a></li>
    <li><a asp-page="/Test">Test (tato stranka)</a></li>
</ul>
