@page
@model SpecEdu.Web.Pages.System.IndexModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["SystemPage.Title"];
}

<!-- Hero Section -->
<section class="bg-spec-primary-light py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold mb-3">@L["SystemPage.Title"]</h1>
                <p class="lead text-muted mb-4">@L["SystemPage.Subtitle"]</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-page="/Account/Register" class="btn btn-spec-primary btn-lg">@L["SystemPage.TryFree"]</a>
                    <a asp-page="/HowItWorks" class="btn btn-spec-outline btn-lg">@L["SystemPage.LearnMore"]</a>
                </div>
            </div>
            <div class="col-lg-6 mt-4 mt-lg-0">
                <img src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=600&h=400&fit=crop"
                     alt="Education" class="img-fluid rounded shadow-lg">
            </div>
        </div>
    </div>
</section>

<!-- Features Overview -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">@L["SystemPage.WhySpecEdu"]</h2>
            <p class="text-muted">@L["SystemPage.WhySpecEduDesc"]</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="spec-card h-100 p-4 text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="var(--spec-primary)" viewBox="0 0 16 16">
                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">@L["SystemPage.Feature1Title"]</h5>
                    <p class="text-muted mb-0">@L["SystemPage.Feature1Desc"]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="spec-card h-100 p-4 text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="var(--spec-primary)" viewBox="0 0 16 16">
                            <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A31.493 31.493 0 0 1 8 14.58a31.481 31.481 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94zM8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10z"/>
                            <path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">@L["SystemPage.Feature2Title"]</h5>
                    <p class="text-muted mb-0">@L["SystemPage.Feature2Desc"]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="spec-card h-100 p-4 text-center">
                    <div class="bg-spec-primary-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="var(--spec-primary)" viewBox="0 0 16 16">
                            <path d="M8 1a5 5 0 0 0-5 5v1h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a6 6 0 1 1 12 0v6a2.5 2.5 0 0 1-2.5 2.5H9.366a1 1 0 0 1-.866.5h-1a1 1 0 1 1 0-2h1a1 1 0 0 1 .866.5H11.5A1.5 1.5 0 0 0 13 12h-1a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h1V6a5 5 0 0 0-5-5z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">@L["SystemPage.Feature3Title"]</h5>
                    <p class="text-muted mb-0">@L["SystemPage.Feature3Desc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Statistics -->
<section class="bg-spec-primary text-white py-5">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-6 col-md-3">
                <div class="display-4 fw-bold">150+</div>
                <div class="text-white-50">@L["SystemPage.StatSchools"]</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="display-4 fw-bold">5000+</div>
                <div class="text-white-50">@L["SystemPage.StatStudents"]</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="display-4 fw-bold">98%</div>
                <div class="text-white-50">@L["SystemPage.StatSatisfaction"]</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="display-4 fw-bold">24/7</div>
                <div class="text-white-50">@L["SystemPage.StatSupport"]</div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-5">@L["SystemPage.Testimonials"]</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="spec-card p-4 h-100">
                    <div class="d-flex align-items-center mb-3">
                        <img src="https://i.pravatar.cc/48?img=1" class="rounded-circle me-3" alt="User">
                        <div>
                            <div class="fw-bold">Mgr. Jana Novakova</div>
                            <small class="text-muted">@L["SystemPage.TestimonialRole1"]</small>
                        </div>
                    </div>
                    <p class="text-muted mb-0">"@L["SystemPage.Testimonial1"]"</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="spec-card p-4 h-100">
                    <div class="d-flex align-items-center mb-3">
                        <img src="https://i.pravatar.cc/48?img=2" class="rounded-circle me-3" alt="User">
                        <div>
                            <div class="fw-bold">PhDr. Petr Svoboda</div>
                            <small class="text-muted">@L["SystemPage.TestimonialRole2"]</small>
                        </div>
                    </div>
                    <p class="text-muted mb-0">"@L["SystemPage.Testimonial2"]"</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="spec-card p-4 h-100">
                    <div class="d-flex align-items-center mb-3">
                        <img src="https://i.pravatar.cc/48?img=3" class="rounded-circle me-3" alt="User">
                        <div>
                            <div class="fw-bold">Ing. Marie Kralova</div>
                            <small class="text-muted">@L["SystemPage.TestimonialRole3"]</small>
                        </div>
                    </div>
                    <p class="text-muted mb-0">"@L["SystemPage.Testimonial3"]"</p>
                </div>
            </div>
        </div>
    </div>
</section>
