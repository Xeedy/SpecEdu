@page
@model SpecEdu.Web.Pages.System.ForClientsModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["ForClientsPage.Title"];
}

<!-- Hero -->
<section class="bg-spec-primary-light py-5">
    <div class="container">
        <h1 class="display-5 fw-bold text-center mb-3">@L["ForClientsPage.Title"]</h1>
        <p class="lead text-center text-muted mb-0">@L["ForClientsPage.Subtitle"]</p>
    </div>
</section>

<!-- Tabs for different roles -->
<section class="py-5">
    <div class="container">
        <ul class="nav nav-pills justify-content-center mb-5" id="clientTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="school-tab" data-bs-toggle="pill" data-bs-target="#school" type="button" role="tab">
                    @L["ForClientsPage.TabSchool"]
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="teacher-tab" data-bs-toggle="pill" data-bs-target="#teacher" type="button" role="tab">
                    @L["ForClientsPage.TabTeacher"]
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="parent-tab" data-bs-toggle="pill" data-bs-target="#parent" type="button" role="tab">
                    @L["ForClientsPage.TabParent"]
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="counseling-tab" data-bs-toggle="pill" data-bs-target="#counseling" type="button" role="tab">
                    @L["ForClientsPage.TabCounseling"]
                </button>
            </li>
        </ul>

        <div class="tab-content" id="clientTabsContent">
            <!-- School Tab -->
            <div class="tab-pane fade show active" id="school" role="tabpanel">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <h2 class="fw-bold mb-4">@L["ForClientsPage.SchoolTitle"]</h2>
                        <p class="text-muted mb-4">@L["ForClientsPage.SchoolDesc"]</p>
                        <ul class="list-unstyled">
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.SchoolBenefit1"]</li>
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.SchoolBenefit2"]</li>
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.SchoolBenefit3"]</li>
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.SchoolBenefit4"]</li>
                        </ul>
                        <a asp-page="/Contact" class="btn btn-spec-primary mt-3">@L["ForClientsPage.ContactUs"]</a>
                    </div>
                    <div class="col-lg-6 mt-4 mt-lg-0">
                        <img src="https://images.unsplash.com/photo-1580582932707-520aed937b7b?w=600&h=400&fit=crop"
                             alt="School" class="img-fluid rounded shadow">
                    </div>
                </div>
            </div>

            <!-- Teacher Tab -->
            <div class="tab-pane fade" id="teacher" role="tabpanel">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <h2 class="fw-bold mb-4">@L["ForClientsPage.TeacherTitle"]</h2>
                        <p class="text-muted mb-4">@L["ForClientsPage.TeacherDesc"]</p>
                        <ul class="list-unstyled">
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.TeacherBenefit1"]</li>
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.TeacherBenefit2"]</li>
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.TeacherBenefit3"]</li>
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.TeacherBenefit4"]</li>
                        </ul>
                    </div>
                    <div class="col-lg-6 mt-4 mt-lg-0">
                        <img src="https://images.unsplash.com/photo-1544717305-2782549b5136?w=600&h=400&fit=crop"
                             alt="Teacher" class="img-fluid rounded shadow">
                    </div>
                </div>
            </div>

            <!-- Parent Tab -->
            <div class="tab-pane fade" id="parent" role="tabpanel">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <h2 class="fw-bold mb-4">@L["ForClientsPage.ParentTitle"]</h2>
                        <p class="text-muted mb-4">@L["ForClientsPage.ParentDesc"]</p>
                        <ul class="list-unstyled">
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.ParentBenefit1"]</li>
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.ParentBenefit2"]</li>
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.ParentBenefit3"]</li>
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.ParentBenefit4"]</li>
                        </ul>
                    </div>
                    <div class="col-lg-6 mt-4 mt-lg-0">
                        <img src="https://images.unsplash.com/photo-1591123120675-6f7f1aae0e5b?w=600&h=400&fit=crop"
                             alt="Parent" class="img-fluid rounded shadow">
                    </div>
                </div>
            </div>

            <!-- Counseling Tab -->
            <div class="tab-pane fade" id="counseling" role="tabpanel">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <h2 class="fw-bold mb-4">@L["ForClientsPage.CounselingTitle"]</h2>
                        <p class="text-muted mb-4">@L["ForClientsPage.CounselingDesc"]</p>
                        <ul class="list-unstyled">
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.CounselingBenefit1"]</li>
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.CounselingBenefit2"]</li>
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.CounselingBenefit3"]</li>
                            <li class="mb-2"><span class="text-spec-primary me-2">&#10003;</span> @L["ForClientsPage.CounselingBenefit4"]</li>
                        </ul>
                    </div>
                    <div class="col-lg-6 mt-4 mt-lg-0">
                        <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=600&h=400&fit=crop"
                             alt="Counseling" class="img-fluid rounded shadow">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
