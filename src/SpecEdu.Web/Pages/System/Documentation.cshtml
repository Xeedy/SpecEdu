@page
@model SpecEdu.Web.Pages.System.DocumentationModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["DocumentationPage.Title"];
}

<!-- Hero -->
<section class="bg-spec-primary-light py-5">
    <div class="container">
        <h1 class="display-5 fw-bold text-center mb-3">@L["DocumentationPage.Title"]</h1>
        <p class="lead text-center text-muted mb-0">@L["DocumentationPage.Subtitle"]</p>
    </div>
</section>

<!-- Search -->
<section class="py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="input-group input-group-lg">
                    <input type="text" class="form-control" placeholder="@L["DocumentationPage.SearchPlaceholder"]">
                    <button class="btn btn-spec-primary" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Glossary -->
<section class="py-5">
    <div class="container">
        <h2 class="fw-bold mb-4">@L["DocumentationPage.GlossaryTitle"]</h2>
        <div class="accordion" id="glossaryAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#spp">
                        <strong>SPP</strong>&nbsp;- @L["DocumentationPage.SppShort"]
                    </button>
                </h2>
                <div id="spp" class="accordion-collapse collapse show" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.SppDesc"]</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ppp">
                        <strong>PPP</strong>&nbsp;- @L["DocumentationPage.PppShort"]
                    </button>
                </h2>
                <div id="ppp" class="accordion-collapse collapse" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.PppDesc"]</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#spc">
                        <strong>SPC</strong>&nbsp;- @L["DocumentationPage.SpcShort"]
                    </button>
                </h2>
                <div id="spc" class="accordion-collapse collapse" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.SpcDesc"]</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#svp">
                        <strong>SVP</strong>&nbsp;- @L["DocumentationPage.SvpShort"]
                    </button>
                </h2>
                <div id="svp" class="accordion-collapse collapse" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.SvpDesc"]</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#plpp">
                        <strong>PLPP</strong>&nbsp;- @L["DocumentationPage.PlppShort"]
                    </button>
                </h2>
                <div id="plpp" class="accordion-collapse collapse" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.PlppDesc"]</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ivp">
                        <strong>IVP</strong>&nbsp;- @L["DocumentationPage.IvpShort"]
                    </button>
                </h2>
                <div id="ivp" class="accordion-collapse collapse" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.IvpDesc"]</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#po">
                        <strong>PO</strong>&nbsp;- @L["DocumentationPage.PoShort"]
                    </button>
                </h2>
                <div id="po" class="accordion-collapse collapse" data-bs-parent="#glossaryAccordion">
                    <div class="accordion-body">@L["DocumentationPage.PoDesc"]</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Quick Links -->
<section class="bg-white py-5">
    <div class="container">
        <h2 class="fw-bold mb-4">@L["DocumentationPage.QuickLinksTitle"]</h2>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <a href="#" class="spec-card p-4 d-block text-decoration-none h-100">
                    <div class="text-spec-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold text-dark">@L["DocumentationPage.GettingStarted"]</h5>
                    <p class="text-muted mb-0 small">@L["DocumentationPage.GettingStartedDesc"]</p>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a href="#" class="spec-card p-4 d-block text-decoration-none h-100">
                    <div class="text-spec-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492zM5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0z"/>
                            <path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52l-.094-.319zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.377l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115l.094-.319z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold text-dark">@L["DocumentationPage.UserGuide"]</h5>
                    <p class="text-muted mb-0 small">@L["DocumentationPage.UserGuideDesc"]</p>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a href="#" class="spec-card p-4 d-block text-decoration-none h-100">
                    <div class="text-spec-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold text-dark">@L["DocumentationPage.FAQ"]</h5>
                    <p class="text-muted mb-0 small">@L["DocumentationPage.FAQDesc"]</p>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a href="#" class="spec-card p-4 d-block text-decoration-none h-100">
                    <div class="text-spec-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                            <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold text-dark">@L["DocumentationPage.VideoTutorials"]</h5>
                    <p class="text-muted mb-0 small">@L["DocumentationPage.VideoTutorialsDesc"]</p>
                </a>
            </div>
        </div>
    </div>
</section>
