@page
@model SpecEdu.Web.Pages.Admin.Schools.IndexModel
@{
    ViewData["Title"] = "Správa škol";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Správa škol</h1>
        <a asp-page="Create" class="btn btn-spec-primary">Přidat školu</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
        </div>
    }

    <div class="spec-card">
        <div class="spec-card-body">
            @if (Model.Schools.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Název</th>
                                <th>Typ</th>
                                <th>Město</th>
                                <th>IČO</th>
                                <th>Stav</th>
                                <th class="text-end">Akce</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var school in Model.Schools)
                            {
                                <tr>
                                    <td>
                                        <strong>@school.Name</strong>
                                    </td>
                                    <td>@school.InstitutionType</td>
                                    <td>@(school.City ?? "-")</td>
                                    <td>@(school.Ico ?? "-")</td>
                                    <td>
                                        @if (school.IsActive)
                                        {
                                            <span class="badge bg-success">Aktivní</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Neaktivní</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-secondary" disabled>Upravit</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted mb-3">Zatím nejsou registrovány žádné školy.</p>
                    <a asp-page="Create" class="btn btn-spec-primary">Přidat první školu</a>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="/Admin/Index" class="btn btn-outline-secondary">Zpět na administraci</a>
    </div>
</div>
