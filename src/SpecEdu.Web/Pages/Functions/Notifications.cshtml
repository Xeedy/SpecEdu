@page
@model SpecEdu.Web.Pages.Functions.NotificationsModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["NotificationsPage.Title"];
}

<!-- Hero -->
<section class="bg-spec-primary-light py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="badge bg-spec-primary mb-3">@L["NotificationsPage.Badge"]</span>
                <h1 class="display-5 fw-bold mb-3">@L["NotificationsPage.Title"]</h1>
                <p class="lead text-muted mb-4">@L["NotificationsPage.Subtitle"]</p>
                <a asp-page="/Account/Register" class="btn btn-spec-primary btn-lg">@L["Common.TryFree"]</a>
            </div>
            <div class="col-lg-6 mt-4 mt-lg-0">
                <img src="https://images.unsplash.com/photo-1611532736597-de2d4265fba3?w=600&h=400&fit=crop"
                     alt="Notifications" class="img-fluid rounded shadow-lg">
            </div>
        </div>
    </div>
</section>

<!-- Notification Types -->
<section class="py-5">
    <div class="container">
        <h2 class="fw-bold text-center mb-5">@L["NotificationsPage.TypesTitle"]</h2>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="var(--spec-warning)" viewBox="0 0 16 16">
                                <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zM8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 6.88 3 6c0-2.42 1.72-4.44 4.005-4.901a1 1 0 1 1 1.99 0A5.002 5.002 0 0 1 13 6c0 .88.32 4.2 1.22 6z"/>
                            </svg>
                        </div>
                        <h5 class="fw-bold mb-0">@L["NotificationsPage.Type1Title"]</h5>
                    </div>
                    <p class="text-muted mb-0">@L["NotificationsPage.Type1Desc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-info bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="var(--spec-info)" viewBox="0 0 16 16">
                                <path d="M4 .5a.5.5 0 0 0-1 0V1H2a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-1V.5a.5.5 0 0 0-1 0V1H4V.5zM2.545 3h10.91c.3 0 .545.224.545.5v1c0 .276-.244.5-.546.5H2.545C2.245 5 2 4.776 2 4.5v-1c0-.276.244-.5.545-.5z"/>
                            </svg>
                        </div>
                        <h5 class="fw-bold mb-0">@L["NotificationsPage.Type2Title"]</h5>
                    </div>
                    <p class="text-muted mb-0">@L["NotificationsPage.Type2Desc"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="spec-card p-4 h-100">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="var(--spec-success)" viewBox="0 0 16 16">
                                <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12.793a.5.5 0 0 0 .854.353l2.853-2.853A1 1 0 0 1 4.414 12H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                            </svg>
                        </div>
                        <h5 class="fw-bold mb-0">@L["NotificationsPage.Type3Title"]</h5>
                    </div>
                    <p class="text-muted mb-0">@L["NotificationsPage.Type3Desc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Sample Notifications -->
<section class="bg-white py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2 class="fw-bold text-center mb-5">@L["NotificationsPage.SampleTitle"]</h2>
                <div class="spec-card">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex align-items-start p-3">
                            <div class="bg-warning rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 40px; height: 40px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white" viewBox="0 0 16 16">
                                    <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zM8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917z"/>
                                </svg>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <h6 class="fw-bold mb-1">@L["NotificationsPage.Sample1Title"]</h6>
                                    <small class="text-muted">2h</small>
                                </div>
                                <p class="text-muted mb-0 small">@L["NotificationsPage.Sample1Desc"]</p>
                            </div>
                        </div>
                        <div class="list-group-item d-flex align-items-start p-3">
                            <div class="bg-spec-primary rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 40px; height: 40px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white" viewBox="0 0 16 16">
                                    <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1h12z"/>
                                </svg>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <h6 class="fw-bold mb-1">@L["NotificationsPage.Sample2Title"]</h6>
                                    <small class="text-muted">1d</small>
                                </div>
                                <p class="text-muted mb-0 small">@L["NotificationsPage.Sample2Desc"]</p>
                            </div>
                        </div>
                        <div class="list-group-item d-flex align-items-start p-3">
                            <div class="bg-success rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 40px; height: 40px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white" viewBox="0 0 16 16">
                                    <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                                </svg>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <h6 class="fw-bold mb-1">@L["NotificationsPage.Sample3Title"]</h6>
                                    <small class="text-muted">3d</small>
                                </div>
                                <p class="text-muted mb-0 small">@L["NotificationsPage.Sample3Desc"]</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
