@page
@model SpecEdu.Web.Pages.Functions.DocumentsModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["DocumentsPage.Title"];
}

<!-- Hero -->
<section class="bg-spec-primary-light py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="badge bg-spec-primary mb-3">@L["DocumentsPage.Badge"]</span>
                <h1 class="display-5 fw-bold mb-3">@L["DocumentsPage.Title"]</h1>
                <p class="lead text-muted mb-4">@L["DocumentsPage.Subtitle"]</p>
                <a asp-page="/Account/Register" class="btn btn-spec-primary btn-lg">@L["Common.TryFree"]</a>
            </div>
            <div class="col-lg-6 mt-4 mt-lg-0">
                <img src="https://images.unsplash.com/photo-1568667256549-094345857637?w=600&h=400&fit=crop"
                     alt="Documents" class="img-fluid rounded shadow-lg">
            </div>
        </div>
    </div>
</section>

<!-- Document Types -->
<section class="py-5">
    <div class="container">
        <h2 class="fw-bold text-center mb-5">@L["DocumentsPage.TypesTitle"]</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
                            <path d="M4.603 14.087a.81.81 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.102.198-.307.526-.568.897-.787a7.68 7.68 0 0 1 1.482-.645 19.697 19.697 0 0 0 1.062-2.227 7.269 7.269 0 0 1-.43-1.295c-.086-.4-.119-.796-.046-1.136.075-.354.274-.672.65-.823.192-.077.4-.12.602-.077a.7.7 0 0 1 .477.365c.088.164.12.356.127.538.007.188-.012.396-.047.614-.084.51-.27 1.134-.52 1.794a10.954 10.954 0 0 0 .98 1.686 5.753 5.753 0 0 1 1.334.05c.364.066.734.195.96.465.12.144.193.32.2.518.007.192-.047.382-.138.563a1.04 1.04 0 0 1-.354.416.856.856 0 0 1-.51.138c-.331-.014-.654-.196-.933-.417a5.712 5.712 0 0 1-.911-.95 11.651 11.651 0 0 0-1.997.406 11.307 11.307 0 0 1-1.02 1.51c-.292.35-.609.656-.927.787a.793.793 0 0 1-.58.029z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">@L["DocumentsPage.Type1Title"]</h5>
                    <p class="text-muted mb-0">@L["DocumentsPage.Type1Desc"]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M5.5 7a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1h-5zM5 9.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5z"/>
                            <path d="M9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5L9.5 0zm0 1v2A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">@L["DocumentsPage.Type2Title"]</h5>
                    <p class="text-muted mb-0">@L["DocumentsPage.Type2Desc"]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="spec-card p-4 h-100">
                    <div class="text-spec-primary mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">@L["DocumentsPage.Type3Title"]</h5>
                    <p class="text-muted mb-0">@L["DocumentsPage.Type3Desc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How it works -->
<section class="bg-white py-5">
    <div class="container">
        <h2 class="fw-bold text-center mb-5">@L["DocumentsPage.HowItWorksTitle"]</h2>
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="d-flex flex-column flex-md-row justify-content-between">
                    <div class="text-center mb-4 mb-md-0 flex-fill">
                        <div class="bg-spec-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">1</div>
                        <h6 class="fw-bold">@L["DocumentsPage.Step1Title"]</h6>
                        <p class="text-muted small mb-0">@L["DocumentsPage.Step1Desc"]</p>
                    </div>
                    <div class="d-none d-md-flex align-items-center px-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="var(--spec-gray-400)" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8z"/>
                        </svg>
                    </div>
                    <div class="text-center mb-4 mb-md-0 flex-fill">
                        <div class="bg-spec-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">2</div>
                        <h6 class="fw-bold">@L["DocumentsPage.Step2Title"]</h6>
                        <p class="text-muted small mb-0">@L["DocumentsPage.Step2Desc"]</p>
                    </div>
                    <div class="d-none d-md-flex align-items-center px-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="var(--spec-gray-400)" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8z"/>
                        </svg>
                    </div>
                    <div class="text-center flex-fill">
                        <div class="bg-spec-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">3</div>
                        <h6 class="fw-bold">@L["DocumentsPage.Step3Title"]</h6>
                        <p class="text-muted small mb-0">@L["DocumentsPage.Step3Desc"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
