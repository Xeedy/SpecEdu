<header class="spec-header">
    <nav class="navbar navbar-expand-lg spec-navbar">
        <div class="container">
            <a class="navbar-brand spec-brand" asp-area="" asp-page="/Index">
                SpecEdu
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link spec-nav-link" asp-area="" asp-page="/Index">@L["HeaderPage.Home"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link spec-nav-link" asp-area="" asp-page="/Privacy">@L["HeaderPage.Privacy"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link spec-nav-link" asp-area="" asp-page="/Test">@L["HeaderPage.Test"]</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    @* Login button - will be replaced with user menu when authenticated *@
                    <a class="btn btn-spec-outline me-2" asp-area="" asp-page="/Account/Login">@L["HeaderPage.Login"]</a>
                    <a class="btn btn-spec-primary" asp-area="" asp-page="/Account/Register">@L["HeaderPage.Register"]</a>
                </div>
            </div>
        </div>
    </nav>
</header>
