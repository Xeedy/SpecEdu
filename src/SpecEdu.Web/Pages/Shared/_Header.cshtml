<header class="spec-header">
    <nav class="navbar navbar-expand-lg spec-navbar">
        <div class="container">
            <a class="navbar-brand spec-brand" asp-area="" asp-page="/Index" aria-label="SpecEdu">
                <span class="spec-brand-spec">Spec</span><span class="spec-brand-edu">Edu</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link spec-nav-link" asp-area="" asp-page="/Index">@L["HeaderPage.Home"]</a>
                    </li>
                    <li class="nav-item dropdown spec-hover-dropdown">
                        <a class="nav-link spec-nav-link dropdown-toggle" asp-area="" asp-page="/System" id="systemDropdown" role="button"> @L["HeaderPage.System"]</a>
                        <ul class="dropdown-menu" aria-labelledby="homeDropdown">
                            <li><a class="dropdown-item" asp-area="" asp-page="/ForClients">@L["HeaderPage.ForClients"]</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/Security">@L["HeaderPage.Security"]</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/Documentation">@L["HeaderPage.Documentation"]</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown spec-hover-dropdown">
                        <a class="nav-link spec-nav-link dropdown-toggle" asp-area="" asp-page="/Functions" id="functionsDropdown" role="button"> @L["HeaderPage.Functions"]</a>
                        <ul class="dropdown-menu" aria-labelledby="homeDropdown">
                            <li><a class="dropdown-item" asp-area="" asp-page="/StudentFiles">@L["HeaderPage.StudentFile"]</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/StudentDocuments">@L["HeaderPage.StudentDocuments"]</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/Diary">@L["HeaderPage.CommunicationDiary"]</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/Notifications">@L["HeaderPage.Notifications"]</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/PLLP">@L["HeaderPage.PLLP"]</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/Calendar">@L["HeaderPage.Calendar"]</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/Messages">@L["HeaderPage.Messages"]</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link spec-nav-link" asp-area="" asp-page="/Overview">@L["HeaderPage.OverView"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link spec-nav-link" asp-area="" asp-page="/Price">@L["HeaderPage.Price"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link spec-nav-link" asp-area="" asp-page="/Contact">@L["HeaderPage.Contact"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link spec-nav-link" asp-area="" asp-page="/Test">@L["HeaderPage.Test"]</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    <a class="btn btn-spec-outline me-2" asp-area="" asp-page="/Account/Login">@L["HeaderPage.Login"]</a>
                    <a class="btn btn-spec-primary" asp-area="" asp-page="/Account/Register">@L["HeaderPage.Register"]</a>
                </div>
            </div>
        </div>
    </nav>
</header>
