<footer class="spec-footer">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <p class="mb-0">
                    &copy; @DateTime.Now.Year @L["FooterPage.Description"]
                </p>
            </div>
            <div class="col-md-6 text-md-end">
                <a asp-area="" asp-page="/Privacy">@L["FooterPage.Privacy"]</a>
                <span class="mx-2">|</span>
                <a asp-area="" asp-page="/Contact">@L["FooterPage.Contact"]</a>
            </div>
        </div>
    </div>
</footer>
