@page "{id:guid}"
@model SpecEdu.Web.Pages.MyChildren.ChildDetailsModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = Model.Child.FullName;
    var initials = $"{Model.Child.FirstName.FirstOrDefault()}{Model.Child.LastName.FirstOrDefault()}".ToUpper();
}

<section class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <!-- Child Profile Card -->
                <div class="spec-card p-4 mb-4">
                    <div class="text-center">
                        <div class="bg-spec-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                            <span class="text-white fw-bold fs-3">@initials</span>
                        </div>
                        <h4 class="fw-bold mb-1">@Model.Child.FullName</h4>
                        <p class="text-muted mb-2">@(Model.Child.SchoolName ?? "")</p>
                        @if (Model.Child.IsActive)
                        {
                            <span class="badge bg-success">@L["Common.Active"]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@L["Common.Inactive"]</span>
                        }
                    </div>
                    <hr />
                    <dl class="row mb-0">
                        <dt class="col-sm-5">@L["StudentsPage.Class"]</dt>
                        <dd class="col-sm-7">@(Model.Child.Class ?? "-")</dd>

                        <dt class="col-sm-5">@L["StudentsPage.BirthDate"]</dt>
                        <dd class="col-sm-7">@(Model.Child.BirthDate?.ToString("dd.MM.yyyy") ?? "-")</dd>
                    </dl>
                </div>

                <!-- Quick Actions -->
                <div class="spec-card p-4">
                    <h6 class="fw-bold mb-3">@L["DashboardPage.QuickActions"]</h6>
                    <div class="d-grid gap-2">
                        <a asp-page="ChildDiary" asp-route-id="@Model.Child.Id" class="btn btn-spec-primary">
                            <i class="bi bi-journal-text me-2"></i>@L["StudentsPage.Diary"]
                        </a>
                        <button class="btn btn-spec-outline" disabled>
                            <i class="bi bi-file-earmark me-2"></i>@L["MyChildrenPage.ViewDocuments"]
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <!-- Recent Diary Entries -->
                <div class="spec-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">@L["DiaryPage.Title"]</h5>
                        <a asp-page="ChildDiary" asp-route-id="@Model.Child.Id" class="btn btn-sm btn-outline-primary">
                            @L["Common.View"]
                        </a>
                    </div>

                    @if (Model.RecentDiaryEntries.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var entry in Model.RecentDiaryEntries)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">@entry.Title</h6>
                                            <p class="text-muted small mb-1">@entry.Content.Substring(0, Math.Min(entry.Content.Length, 100))@(entry.Content.Length > 100 ? "..." : "")</p>
                                            <small class="text-muted">
                                                <i class="bi bi-person me-1"></i>@(entry.CreatedByName ?? "")
                                            </small>
                                        </div>
                                        <small class="text-muted">@entry.CreatedAt.ToString("dd.MM.yyyy")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted mb-0">@L["DiaryPage.NoEntries"]</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="mt-3">
            <a asp-page="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>@L["Common.Back"]
            </a>
        </div>
    </div>
</section>
