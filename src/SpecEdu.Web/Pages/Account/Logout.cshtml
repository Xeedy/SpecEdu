@page
@model SpecEdu.Web.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Odhlášení";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 text-center">
            <h1 class="mb-3">Odhlášení</h1>
            <p class="text-muted mb-4">Opravdu se chcete odhlásit?</p>

            <form method="post">
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-spec-primary">Odhlásit se</button>
                    <a href="/" class="btn btn-outline-secondary">Zrušit</a>
                </div>
            </form>
        </div>
    </div>
</div>
