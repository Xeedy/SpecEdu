@page
@model SpecEdu.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Přístup odepřen";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor"
                     class="text-danger" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                </svg>
            </div>

            <h1 class="mb-3">Přístup odepřen</h1>
            <p class="text-muted mb-4">
                Nemáte oprávnění k zobrazení této stránky. Pokud si myslíte, že se jedná o chybu,
                kontaktujte prosím správce systému.
            </p>

            <div class="d-grid gap-2 col-6 mx-auto">
                <a asp-page="/Index" class="btn btn-spec-primary">Zpět na úvodní stránku</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Account/Logout" class="btn btn-outline-secondary">Odhlásit se</a>
                }
            </div>
        </div>
    </div>
</div>
